  {
   "n": "Manhattan steak frites",
   "course": "m",
   "prep_min": 40,
   "cook_min": 50,
   "make_ahead": "Shallot butter up to 3 days",
   "ingredients": [
    {
     "q": 2,
     "u": "",
     "item": "shallots, finely diced",
     "aisle": "Produce"
    },
    {
     "q": 80,
     "u": "ml",
     "item": "red wine",
     "aisle": "Drinks"
    },
    {
     "q": 60,
     "u": "g",
     "item": "butter, softened",
     "aisle": "Dairy"
    },
    {
     "q": 1,
     "u": "",
     "item": "pinch salt",
     "aisle": "Pantry"
    },
    {
     "q": 800,
     "u": "g",
     "item": "potatoes",
     "aisle": "Produce"
    },
    {
     "q": 1,
     "u": "l",
     "item": "neutral oil for frying",
     "aisle": "Pantry"
    },
    {
     "q": 800,
     "u": "g",
     "item": "sirloin steak, in four pieces",
     "aisle": "Meat"
    },
    {
     "q": 1,
     "u": "tbsp",
     "item": "oil for searing",
     "aisle": "Pantry"
    }
   ],
   "steps": [
    {
     "text": "Simmer the shallots with the wine until almost dry. Cool, then mix into the butter with the salt and chill.",
     "min": 20
    },
    {
     "text": "Cut the potatoes into frites, rinse and dry thoroughly.",
     "min": 10
    },
    {
     "text": "Fry in oil at 140C, then drain and cool.",
     "min": 20
    },
    {
     "text": "Fry again at 185C until crisp. Salt lightly.",
     "min": 3
    },
    {
     "text": "Season the steaks and sear hard in a hot pan with the oil to your preferred doneness.",
     "min": 6
    },
    {
     "text": "Rest the steaks, then slice and top with the shallot red wine butter. Serve with frites.",
     "min": 8
    }
   ]
  },
  {
   "n": "The Chairman's chocolate fondant",
   "course": "w",
   "prep_min": 15,
   "cook_min": 12,
   "make_ahead": "Batter up to 1 day, chilled",
   "ingredients": [
    {
     "q": 145,
     "u": "g",
     "item": "butter, plus extra for the moulds",
     "aisle": "Dairy"
    },
    {
     "q": 125,
     "u": "g",
     "item": "dark chocolate",
     "aisle": "Pantry"
    },
    {
     "q": 2,
     "u": "",
     "item": "eggs",
     "aisle": "Dairy"
    },
    {
     "q": 2,
     "u": "",
     "item": "egg yolks",
     "aisle": "Dairy"
    },
    {
     "q": 60,
     "u": "g",
     "item": "caster sugar",
     "aisle": "Pantry"
    },
    {
     "q": 30,
     "u": "g",
     "item": "plain flour",
     "aisle": "Pantry"
    }
   ],
   "steps": [
    {
     "text": "Butter four 150ml moulds. Heat the oven to 200C.",
     "min": 4
    },
    {
     "text": "Melt the chocolate with the butter gently and cool slightly.",
     "min": 5
    },
    {
     "text": "Whisk the eggs, yolks and sugar until pale. Stir in the chocolate mixture, then fold in the flour.",
     "min": 5
    },
    {
     "text": "Divide among the moulds and bake until the edges are set and centres stay soft.",
     "min": 10
    },
    {
     "text": "Rest briefly, loosen the edges and turn onto plates. Serve immediately.",
     "min": 3
    }
   ]
  },
