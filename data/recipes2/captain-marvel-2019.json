   "n": "Video store brown butter parmesan popcorn",
   "course": "s",
   "prep_min": 5,
   "cook_min": 10,
   "make_ahead": "Brown the butter up to 3 days ahead and keep it chilled to rewarm; pop the corn just before serving",
   "ingredients": [
    {
     "q": 120,
     "u": "g",
     "item": "popcorn kernels",
     "aisle": "Pantry"
    },
    {
     "q": 3,
     "u": "tbsp",
     "item": "vegetable oil",
     "aisle": "Pantry"
    },
    {
     "q": 80,
     "u": "g",
     "item": "butter",
     "aisle": "Dairy"
    },
    {
     "q": 40,
     "u": "g",
     "item": "parmesan, finely grated",
     "aisle": "Dairy"
    },
    {
     "q": 1,
     "u": "tsp",
     "item": "sea salt flakes",
     "aisle": "Pantry"
    },
    {
     "q": 1,
     "u": "tsp",
     "item": "rosemary leaves",
     "aisle": "Produce"
    }
   ],
   "steps": [
    {
     "text": "Heat the oil and kernels in a big lidded pot over medium-high heat, shaking until the popping slows.",
     "min": 8
