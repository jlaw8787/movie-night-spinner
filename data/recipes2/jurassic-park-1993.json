   "n": "Dino egg cookies",
   "course": "s",
   "prep_min": 25,
   "cook_min": 15,
   "make_ahead": "Up to 3 days, airtight tin",
   "ingredients": [
    {
     "q": 125,
     "u": "g",
     "item": "butter",
     "aisle": "Dairy"
    },
    {
     "q": 150,
     "u": "g",
     "item": "brown sugar",
     "aisle": "Pantry"
    },
    {
     "q": 1,
     "u": "",
     "item": "egg",
