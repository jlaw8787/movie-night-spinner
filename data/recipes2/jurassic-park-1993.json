    {
     "q": 2,
     "u": "tbsp",
     "item": "cocoa powder",
     "aisle": "Pantry"
    }
   ],
   "steps": [
    {
     "text": "Brown the butter in a small pan and cool for 10 minutes until just warm.",
     "min": 10
    },
    {
     "text": "Beat the butter with the sugar and egg, then mix in the flour to a soft dough.",
     "min": 5
