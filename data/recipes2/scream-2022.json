   "make_ahead": "Bake and scoop the potatoes up to 2 days ahead and keep them in the fridge; crisp, fill and top on the night",
   "ingredients": [
    {
     "q": 6,
     "u": "",
     "item": "medium potatoes, about 1.2kg, scrubbed",
     "aisle": "Produce"
    },
    {
