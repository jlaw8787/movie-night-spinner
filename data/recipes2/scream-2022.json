     "q": 150,
     "u": "g",
     "item": "sour cream",
     "aisle": "Dairy"
    },
    {
     "q": 3,
     "u": "",
     "item": "spring onions, sliced",
     "aisle": "Produce"
    },
    {
     "q": 2,
     "u": "tbsp",
     "item": "pickled jalapeños, chopped",
     "aisle": "Pantry"
    }
   ],
   "steps": [
    {
     "text": "Heat the oven to 200C, prick the potatoes and bake until tender.",
     "min": 60
    },
    {
     "text": "Cool until you can handle them.",
     "min": 10
    },
    {
     "text": "Halve and scoop out most of the flesh, leaving a thin wall.",
     "min": 8
    },
    {
     "text": "Brush the skins with the oil, season with salt, pepper and paprika and roast, turning once, until crisp.",
     "min": 15
    },
    {
     "text": "Fill with the cheddar and bake until melted.",
     "min": 5
    },
    {
     "text": "Top with sour cream, spring onions and jalapeños.",
     "min": 3
    }
   ],
   "veg": true,
