  {
   "n": "Charred pineapple salsa with lime chips",
   "course": "s",
   "prep_min": 10,
   "cook_min": 16,
   "make_ahead": "",
   "ingredients": [
    {
     "q": null,
     "u": "",
     "item": "half pineapple, as needed",
     "aisle": "Produce"
    },
    {
     "q": 1,
     "u": "",
     "item": "red onion",
     "aisle": "Produce"
    },
    {
     "q": 1,
     "u": "",
     "item": "jalapeño",
     "aisle": "Produce"
    },
    {
     "q": 1,
     "u": "",
     "item": "bunch coriander",
     "aisle": "Produce"
    },
    {
     "q": 3,
     "u": "",
     "item": "limes",
     "aisle": "Produce"
    },
    {
     "q": 250,
     "u": "g",
     "item": "corn chips",
     "aisle": "Pantry"
    }
   ],
   "steps": [
    {
     "text": "Cut half a pineapple into thick slices and char on a very hot grill pan for 3 minutes a side.",
     "min": 6
    },
    {
     "text": "Cool and dice.",
     "min": 3
    },
    {
     "text": "Mix with half a finely diced red onion, the chopped jalapeño, a handful of chopped coriander, the juice of the limes and salt.",
     "min": 5
    },
    {
     "text": "Rest 10 minutes.",
     "min": 10
    },
    {
     "text": "Toss the corn chips with the zest of the lime and half a tsp salt and serve with the salsa.",
     "min": 2
    }
   ]
  },
