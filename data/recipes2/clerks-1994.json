   ],
   "steps": [
    {
     "text": "Whisk the eggs and caster sugar until thick, then fold in the flour and cocoa.",
     "min": 15
    },
    {
     "text": "Spread in a lined slice tin and bake at 180C for 12 minutes. Cool and cut into 12 rectangles.",
     "min": 15
    },
    {
     "text": "Beat the butter, most of the icing sugar, marshmallow fluff and vanilla until fluffy. Sandwich pairs of cake with it.",
     "min": 15
    },
    {
     "text": "Melt the chocolate with the cream and dip the cakes in it. Let them set.",
     "min": 20
    },
    {
     "text": "Mix the leftover icing sugar with a few drops of water and pipe a white squiggle on top.",
     "min": 25
    }
