{
 "serves": 4,
 "dishes": [
  {
   "n": "Drive-in butter toffee popcorn",
   "course": "s",
   "prep_min": 15,
   "cook_min": 50,
   "make_ahead": "Up to 3 days in an airtight tin",
   "ingredients": [
    {
     "q": 120,
     "u": "g",
     "item": "popcorn kernels",
     "aisle": "Pantry"
    },
    {
     "q": 2,
     "u": "tbsp",
     "item": "coconut oil",
     "aisle": "Pantry"
    },
    {
     "q": 100,
     "u": "g",
     "item": "butter",
     "aisle": "Dairy"
    },
    {
     "q": 150,
     "u": "g",
     "item": "brown sugar",
     "aisle": "Pantry"
    },
    {
     "q": 3,
     "u": "tbsp",
     "item": "golden syrup",
     "aisle": "Pantry"
    },
    {
     "q": 0.5,
     "u": "tsp",
     "item": "bicarb soda",
     "aisle": "Pantry"
    },
    {
     "q": 1,
     "u": "tsp",
     "item": "salt",
     "aisle": "Pantry"
    },
    {
     "q": 100,
     "u": "g",
     "item": "roasted peanuts",
     "aisle": "Pantry"
    }
   ],
   "steps": [
    {
     "text": "Pop the kernels in the coconut oil in a covered pot, shaking, and tip into a large bowl",
     "min": 8
    },
    {
     "text": "Melt the butter with the sugar and golden syrup and boil for 4 minutes, then stir in the bicarb and salt",
     "min": 7
    },
    {
     "text": "Pour over the popcorn with the peanuts and toss well",
     "min": 3
    },
    {
     "text": "Spread on lined trays and bake at 120C, stirring twice",
     "min": 30
    },
    {
     "text": "Cool and break up",
     "min": 5
    }
   ],
   "veg": true,
   "af": true
  },
