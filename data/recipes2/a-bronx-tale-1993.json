  {
   "n": "Chez Bippy provolone-stuffed fried olives",
   "course": "s",
   "prep_min": 30,
   "cook_min": 2,
   "make_ahead": "Crumb up to 4 hours ahead, keep chilled; fry just before serving",
   "ingredients": [
    {
     "q": 24,
     "u": "",
     "item": "large pitted green olives",
     "aisle": "Pantry"
    },
    {
     "q": 80,
     "u": "g",
     "item": "sharp provolone",
     "aisle": "Dairy"
    },
    {
     "q": 40,
     "u": "g",
     "item": "plain flour",
     "aisle": "Pantry"
    },
    {
     "q": 1,
     "u": "",
     "item": "egg",
     "aisle": "Dairy"
    },
    {
     "q": 80,
     "u": "g",
     "item": "fine breadcrumbs",
     "aisle": "Pantry"
    },
    {
     "q": 500,
     "u": "ml",
     "item": "neutral oil, for frying",
     "aisle": "Pantry"
    },
    {
     "q": 0.5,
     "u": "",
     "item": "lemon, zested and juiced",
     "aisle": "Produce"
    },
    {
     "q": 1,
     "u": "",
     "item": "garlic clove, crushed",
     "aisle": "Produce"
    },
    {
     "q": 100,
     "u": "g",
     "item": "mayonnaise",
     "aisle": "Pantry"
    },
    {
     "q": null,
     "u": "",
     "item": "chilli flakes, to dust",
     "aisle": "Spices"
    }
   ],
   "steps": [
    {
     "text": "Drain the olives and pat dry. Cut the provolone into small sticks and push one into each olive.",
     "min": 10
    },
    {
     "text": "Roll in flour, dip in beaten egg, then coat in breadcrumbs.",
     "min": 10
    },
    {
     "text": "Stir the lemon zest, juice and garlic into the mayonnaise to make the aioli.",
     "min": 3
    },
    {
     "text": "Heat the oil to 180C and fry in two batches until deep golden, then drain.",
     "min": 7
    },
    {
     "text": "Dust with chilli flakes and serve with the aioli.",
     "min": 2
    }
   ]
