  {
   "n": "Sweetbreads à la Gusteau",
   "course": "m",
   "prep_min": 200,
   "cook_min": 20,
   "make_ahead": "Soak, blanch and press the sweetbreads up to 1 day ahead and keep chilled",
   "ingredients": [
    {
     "q": 600,
     "u": "g",
     "item": "veal sweetbreads",
     "aisle": "Meat"
    },
    {
     "q": null,
     "u": "",
     "item": "salt, to taste",
     "aisle": "Pantry"
    },
    {
     "q": 2,
     "u": "tbsp",
     "item": "plain flour",
     "aisle": "Pantry"
    },
    {
     "q": 50,
     "u": "g",
     "item": "butter",
     "aisle": "Dairy"
    },
    {
     "q": 180,
     "u": "ml",
     "item": "chicken stock",
     "aisle": "Pantry"
    },
    {
     "q": 1,
     "u": "tsp",
     "item": "lemon juice",
     "aisle": "Produce"
    }
   ],
   "steps": [
    {
     "text": "Soak the veal sweetbreads in cold water in the fridge for 2 hours.",
     "min": 120
    },
    {
     "text": "Simmer the sweetbreads in salted water for 4 minutes, then plunge into iced water and peel off the membrane.",
     "min": 15
    },
    {
     "text": "Press the sweetbreads under a weighted tray in the fridge for an hour.",
     "min": 60
    },
    {
     "text": "Slice into 2cm pieces, dust with the flour and pan-fry in 30g of the butter for 3 minutes a side until golden.",
     "min": 10
    },
    {
     "text": "Deglaze the pan with the chicken stock and lemon juice, reduce by half, then swirl in the remaining 20g cold butter and spoon the sauce over the sweetbreads.",
     "min": 8
    }
   ],
