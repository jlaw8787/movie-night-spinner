  {
   "n": "Boardwalk pretzel bites",
   "course": "s",
   "prep_min": 30,
   "cook_min": 95,
   "make_ahead": "Best eaten warm, same day",
   "ingredients": [
    {
     "q": 265,
     "u": "g",
     "item": "plain flour",
     "aisle": "Pantry"
    },
    {
     "q": 4,
     "u": "g",
     "item": "instant yeast",
     "aisle": "Pantry"
    },
    {
     "q": 1,
     "u": "tsp",
     "item": "sugar",
     "aisle": "Pantry"
    },
    {
     "q": 0.5,
     "u": "tsp",
     "item": "salt",
     "aisle": "Pantry"
    },
    {
     "q": 160,
     "u": "ml",
     "item": "warm water",
     "aisle": "Pantry"
    },
    {
     "q": 1,
     "u": "l",
     "item": "water, for boiling",
     "aisle": "Pantry"
    },
    {
     "q": 30,
     "u": "g",
     "item": "bicarbonate of soda",
     "aisle": "Pantry"
    },
    {
     "q": 35,
     "u": "g",
     "item": "butter",
     "aisle": "Dairy"
    },
    {
     "q": 150,
     "u": "ml",
     "item": "milk",
     "aisle": "Dairy"
    },
    {
     "q": 100,
     "u": "g",
     "item": "grated cheddar",
     "aisle": "Dairy"
    },
    {
     "q": 4,
     "u": "tbsp",
     "item": "yellow mustard",
     "aisle": "Pantry"
    },
    {
     "q": null,
     "u": "",
     "item": "coarse salt, to finish",
     "aisle": "Spices"
    }
   ],
   "steps": [
    {
     "text": "Mix the flour (keeping a spoonful back for the cheese dip), yeast, sugar, salt and warm water, then knead until smooth.",
     "min": 15
    },
    {
     "text": "Cover and rise until doubled.",
     "min": 60
    },
    {
     "text": "Roll into ropes and cut into 24 bites. Bring the boiling water and bicarb to a simmer.",
     "min": 10
    },
    {
     "text": "Boil the bites in batches for 20 seconds, then drain on baking paper.",
     "min": 5
    },
    {
     "text": "Bake at 220C until deep golden, then brush with melted butter and coarse salt.",
     "min": 13
    },
    {
     "text": "For the dip, melt butter, stir in the remaining flour, whisk in the milk and simmer. Off the heat, stir in the cheddar and serve with mustard.",
     "min": 5
    }
   ]
  },
  {
