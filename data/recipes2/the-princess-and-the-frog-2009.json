   "prep_min": 28,
   "cook_min": 135,
   "make_ahead": "Make the dough up to 1 day ahead and prove it slowly in the fridge overnight instead of the 2 hour prove; cut, fry and dust with icing sugar just before serving",
   "ingredients": [
    {
     "q": 500,
     "u": "g",
     "item": "plain flour",
     "aisle": "Pantry"
    },
    {
     "q": 7,
     "u": "g",
     "item": "dried yeast",
     "aisle": "Pantry"
    },
    {
     "q": 50,
     "u": "g",
     "item": "caster sugar",
     "aisle": "Pantry"
    },
