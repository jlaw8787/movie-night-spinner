     "item": "duck legs",
     "aisle": "Meat"
    },
    {
     "q": 2,
     "u": "tbsp",
     "item": "sea salt flakes",
     "aisle": "Pantry"
    },
    {
     "q": 1,
     "u": "",
     "item": "small bunch thyme",
     "aisle": "Produce"
    },
    {
     "q": 4,
     "u": "",
     "item": "garlic cloves",
     "aisle": "Produce"
    },
    {
     "q": 1,
     "u": "kg",
     "item": "potatoes",
     "aisle": "Produce"
    },
    {
     "q": 150,
     "u": "g",
     "item": "salad leaves",
     "aisle": "Produce"
    }
   ],
   "steps": [
    {
     "text": "Rub the duck legs with salt, thyme and garlic.",
     "min": 15
    },
    {
     "text": "Cure in the fridge overnight (included in cook time).",
     "min": 720
    },
    {
     "text": "Rinse and dry the legs and arrange in a snug dish.",
     "min": 10
    },
    {
     "text": "Cook slowly in their own fat at 140C for 2.5 hours until very tender.",
     "min": 150
    },
    {
     "text": "Cut the potatoes, toss in some of the fat and roast at 200C until golden.",
     "min": 40
    },
    {
     "text": "Crisp the legs skin side down in a hot pan and serve with potatoes and a green salad.",
     "min": 15
    }
   ]
  },
