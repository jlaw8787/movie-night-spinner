     "q": 150,
     "u": "g",
     "item": "plain flour",
     "aisle": "Pantry"
    },
    {
     "q": 4,
     "u": "",
     "item": "eggs",
     "aisle": "Dairy"
    },
    {
     "q": 150,
     "u": "g",
     "item": "gruyere, finely grated",
     "aisle": "Dairy"
    },
    {
     "q": 1,
