     "item": "dijon mustard",
     "aisle": "Pantry"
    },
    {
     "q": 0.5,
     "u": "tsp",
     "item": "ground black pepper",
     "aisle": "Spices"
    }
   ],
   "steps": [
    {
     "text": "Heat the oven to 200C. Bring the milk, 125ml water, butter and salt to the boil, tip in the flour and beat over the heat until it comes away from the pan.",
     "min": 6
    },
    {
     "text": "Cool 5 minutes, then beat in the eggs one at a time, then 120g of the gruyere, the mustard and pepper.",
     "min": 10
    },
    {
     "text": "Pipe or spoon walnut-sized balls onto lined trays and scatter with the rest of the gruyere.",
     "min": 8
    },
    {
     "text": "Bake until puffed and deep golden, and serve warm.",
     "min": 25
    }
