   "n": "Opera managers' gougeres",
   "course": "s",
   "prep_min": 19,
   "cook_min": 30,
   "make_ahead": "Pipe the gougeres and freeze them raw up to 1 month ahead, then bake from frozen for 5 extra minutes",
   "ingredients": [
    {
     "q": 125,
     "u": "ml",
     "item": "milk",
     "aisle": "Dairy"
    },
    {
     "q": 100,
