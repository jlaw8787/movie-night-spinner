  {
   "n": "Mile-high sopapillas",
   "course": "w",
   "prep_min": 20,
   "cook_min": 40,
   "make_ahead": "Best eaten warm, same day",
   "ingredients": [
    {
     "q": 250,
     "u": "g",
     "item": "plain flour",
     "aisle": "Pantry"
    },
    {
     "q": 2,
     "u": "tsp",
     "item": "baking powder",
     "aisle": "Pantry"
    },
    {
     "q": 1,
     "u": "tsp",
     "item": "salt",
     "aisle": "Pantry"
    },
    {
     "q": 30,
     "u": "g",
     "item": "butter",
     "aisle": "Dairy"
    },
    {
     "q": 180,
     "u": "ml",
     "item": "warm water",
     "aisle": "Pantry"
    },
    {
     "q": 1,
     "u": "l",
     "item": "vegetable oil, for frying",
     "aisle": "Pantry"
    },
    {
     "q": 120,
     "u": "g",
     "item": "honey",
     "aisle": "Pantry"
