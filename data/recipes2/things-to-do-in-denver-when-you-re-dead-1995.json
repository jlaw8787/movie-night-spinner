    {
     "q": 1,
     "u": "",
     "item": "bunch chives",
     "aisle": "Produce"
    },
    {
     "q": null,
     "u": "",
     "item": "salt and pepper, to taste",
     "aisle": "Spices"
    }
   ],
   "steps": [
    {
     "text": "Boil the eggs hard in a pot of simmering water.",
     "min": 10
    },
    {
     "text": "Cool the eggs in iced water, then peel and halve them.",
     "min": 5
    },
    {
     "text": "Mash the yolks with the mayonnaise, Dijon, pickle juice, salt and pepper until smooth.",
     "min": 5
    },
    {
     "text": "Pipe or spoon the yolk mix back into the whites. Finish with smoked paprika and chopped chives.",
     "min": 5
    }
   ],
   "veg": true,
   "af": true
