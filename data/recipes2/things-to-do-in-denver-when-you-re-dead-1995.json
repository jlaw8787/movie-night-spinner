    {
     "q": 1,
     "u": "tsp",
     "item": "ground cinnamon",
     "aisle": "Spices"
    }
   ],
   "steps": [
    {
     "text": "Mix the flour, baking powder and salt. Rub in the butter, then add the warm water and mix to a soft dough.",
     "min": 10
    },
    {
     "text": "Rest the dough, covered, so it relaxes.",
     "min": 20
    },
    {
     "text": "Roll the dough out 3mm thick and cut into 16 squares.",
     "min": 10
    },
    {
     "text": "Fry in batches in oil heated to 180C for about a minute a side, until puffed and golden. Drain on paper towel.",
     "min": 10
    },
    {
     "text": "Drizzle with honey and dust with cinnamon.",
     "min": 2
    }
