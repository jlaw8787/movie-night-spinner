   "n": "Afterlife Advice devilled eggs",
   "course": "s",
   "prep_min": 15,
   "cook_min": 10,
   "make_ahead": "Up to 1 day, keep chilled",
   "ingredients": [
    {
     "q": 6,
     "u": "",
     "item": "eggs",
     "aisle": "Dairy"
    },
    {
     "q": 3,
     "u": "tbsp",
     "item": "mayonnaise",
     "aisle": "Pantry"
    },
    {
     "q": 1,
     "u": "tsp",
     "item": "Dijon mustard",
     "aisle": "Pantry"
    },
    {
     "q": 1,
     "u": "tsp",
     "item": "pickle juice",
     "aisle": "Pantry"
    },
    {
     "q": 1,
     "u": "tsp",
     "item": "smoked paprika",
     "aisle": "Spices"
