  {
   "n": "Safari camp beef samosas with mint yoghurt",
   "course": "s",
   "prep_min": 35,
   "cook_min": 20,
   "make_ahead": "Filled samosas up to 1 day, keep chilled",
   "ingredients": [
    {
     "q": 400,
     "u": "g",
     "item": "beef mince",
     "aisle": "Meat"
    },
    {
     "q": 1,
     "u": "",
     "item": "onion, diced",
     "aisle": "Produce"
    },
    {
     "q": 2,
     "u": "",
     "item": "garlic cloves, crushed",
     "aisle": "Produce"
    },
    {
     "q": 2,
     "u": "tsp",
     "item": "curry powder",
     "aisle": "Spices"
    },
    {
     "q": 1,
     "u": "tsp",
     "item": "garam masala",
     "aisle": "Spices"
    },
    {
     "q": 1,
     "u": "",
     "item": "carrot, grated",
     "aisle": "Produce"
    },
    {
     "q": 100,
     "u": "g",
     "item": "frozen peas",
     "aisle": "Frozen"
    },
    {
     "q": 1,
     "u": "",
     "item": "small bunch coriander, chopped",
     "aisle": "Produce"
    },
    {
     "q": 6,
     "u": "",
     "item": "spring roll wrappers",
     "aisle": "Frozen"
    },
    {
     "q": 1,
     "u": "l",
     "item": "vegetable oil, for frying",
     "aisle": "Pantry"
    },
    {
     "q": 200,
     "u": "g",
     "item": "Greek yoghurt",
     "aisle": "Dairy"
    },
    {
     "q": 1,
     "u": "",
     "item": "small bunch mint, chopped",
     "aisle": "Produce"
    }
   ],
   "steps": [
    {
     "text": "Fry the mince, onion and garlic until browned. Add the curry powder, garam masala, carrot and peas and cook, then stir through the coriander and cool.",
     "min": 15
    },
    {
     "text": "Cut the wrappers into strips, spoon filling at one end and fold into triangles, sealing with water.",
     "min": 20
    },
    {
     "text": "Fry at 180C until golden, working in batches.",
     "min": 10
    },
    {
     "text": "Mix the yoghurt with the mint and a pinch of salt for dipping.",
     "min": 5
    },
    {
     "text": "Serve the samosas hot with the mint yoghurt.",
     "min": 5
    }
