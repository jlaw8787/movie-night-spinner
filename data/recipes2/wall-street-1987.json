     "item": "neutral oil",
     "aisle": "Pantry"
    }
   ],
   "steps": [
    {
     "text": "The night before, salt the rib eyes and leave uncovered in the fridge to dry-brine. Bring to room temperature 30 minutes before cooking.",
     "min": 5
    },
    {
     "text": "Sear the steaks hard in a very hot oiled pan on both sides.",
     "min": 8
    },
    {
     "text": "Add the butter and rosemary and baste the steaks. Rest on a plate for 8 minutes.",
     "min": 8
    },
    {
     "text": "In the same pan, crush in the peppercorns, add the brandy and flame it carefully.",
     "min": 3
    },
    {
     "text": "Add the stock and cream and reduce until the sauce coats a spoon.",
     "min": 8
    },
    {
     "text": "Pour the sauce over the rested steaks.",
     "min": 3
    }
