  {
   "n": "Golde's Friday night challah",
   "course": "s",
   "prep_min": 30,
   "cook_min": 177,
   "make_ahead": "Bake up to 1 day ahead and keep wrapped; the dough can do its first prove overnight in the fridge",
   "ingredients": [
    {
     "q": 7,
     "u": "g",
     "item": "dried yeast",
     "aisle": "Pantry"
    },
    {
     "q": 3,
     "u": "tbsp",
     "item": "honey",
     "aisle": "Pantry"
    },
    {
     "q": 200,
     "u": "ml",
     "item": "warm water",
     "aisle": "Pantry"
    },
    {
     "q": 500,
     "u": "g",
     "item": "bread flour",
     "aisle": "Pantry"
    },
    {
     "q": 1.5,
     "u": "tsp",
     "item": "salt",
     "aisle": "Spices"
    },
    {
     "q": 2,
     "u": "",
     "item": "eggs",
     "aisle": "Dairy"
    },
    {
     "q": 1,
     "u": "",
     "item": "egg yolk, for glazing",
     "aisle": "Dairy"
    },
    {
     "q": 60,
     "u": "ml",
     "item": "vegetable oil",
     "aisle": "Pantry"
    },
    {
     "q": 1,
     "u": "tbsp",
     "item": "sesame seeds",
     "aisle": "Spices"
    }
   ],
   "steps": [
    {
     "text": "Stir the yeast and honey into the warm water and leave until foamy.",
     "min": 5
    },
    {
     "text": "Add the flour, salt, eggs and oil and knead for 10 minutes until smooth and springy.",
     "min": 12
    },
    {
     "text": "Cover and prove until doubled.",
     "min": 90
    },
    {
     "text": "Divide into 3, roll each into a 40cm rope and plait them, tucking the ends under.",
     "min": 10
    },
    {
     "text": "Set on a lined tray, cover loosely and prove until puffy. Heat the oven to 190C.",
     "min": 45
    },
    {
     "text": "Brush with the egg yolk, scatter with sesame seeds and bake until deep golden and hollow when tapped underneath.",
     "min": 30
    },
    {
     "text": "Cool on a rack before tearing.",
     "min": 15
    }
   ],
