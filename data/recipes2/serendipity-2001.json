  {
   "n": "Wollman Rink roasted chestnuts",
   "course": "s",
   "prep_min": 20,
   "cook_min": 45,
   "make_ahead": "",
   "ingredients": [
    {
     "q": 400,
     "u": "g",
     "item": "chestnuts",
     "aisle": "Produce"
    },
    {
     "q": 0.25,
     "u": "tsp",
     "item": "sea salt flakes",
     "aisle": "Pantry"
    }
   ],
   "steps": [
    {
     "text": "Score a cross through the shell of each chestnut.",
     "min": 10
    },
    {
     "text": "Soak in water and drain.",
     "min": 20
    },
    {
     "text": "Roast on a tray at 220C until the shells curl back.",
     "min": 20
    },
    {
     "text": "Wrap in a clean towel to steam.",
     "min": 5
    },
    {
     "text": "Peel while still warm, sprinkle with salt and serve.",
     "min": 10
    }
   ],
   "veg": true,
   "af": true
