  {
   "n": "Manhattan bistro steak",
   "course": "m",
   "prep_min": 20,
   "cook_min": 42,
   "make_ahead": "",
   "ingredients": [
    {
     "q": 800,
     "u": "g",
     "item": "potatoes",
     "aisle": "Produce"
    },
    {
     "q": 1,
     "u": "l",
     "item": "neutral oil, for frying",
     "aisle": "Pantry"
    },
    {
     "q": 4,
     "u": "",
     "item": "sirloin steaks (about 200g each)",
     "aisle": "Meat"
    },
    {
     "q": 1,
     "u": "tbsp",
     "item": "neutral oil",
     "aisle": "Pantry"
    },
    {
     "q": 40,
     "u": "g",
     "item": "butter",
     "aisle": "Dairy"
    },
    {
     "q": 4,
     "u": "",
     "item": "sprigs thyme",
     "aisle": "Produce"
    },
    {
     "q": 1,
     "u": "tsp",
     "item": "cracked black peppercorns",
     "aisle": "Spices"
    },
    {
     "q": 40,
     "u": "ml",
     "item": "brandy",
     "aisle": "Bottle shop"
    },
    {
     "q": 150,
     "u": "ml",
     "item": "beef stock",
     "aisle": "Pantry"
    },
    {
     "q": 100,
