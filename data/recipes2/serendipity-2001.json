     "q": 250,
     "u": "g",
     "item": "plain flour",
     "aisle": "Pantry"
    },
    {
     "q": 1,
     "u": "tsp",
     "item": "bicarbonate of soda",
     "aisle": "Pantry"
    },
    {
     "q": 2,
     "u": "tsp",
     "item": "ground ginger",
     "aisle": "Spices"
    },
    {
     "q": 1,
     "u": "tsp",
     "item": "ground cinnamon",
     "aisle": "Spices"
    },
    {
     "q": 1,
     "u": "",
     "item": "egg",
     "aisle": "Dairy"
    },
    {
     "q": 125,
     "u": "ml",
     "item": "milk",
     "aisle": "Dairy"
    },
    {
     "q": 100,
     "u": "g",
     "item": "icing sugar",
     "aisle": "Pantry"
    },
    {
     "q": 1,
     "u": "tbsp",
     "item": "lemon juice",
     "aisle": "Produce"
    }
   ],
   "steps": [
    {
     "text": "Heat the oven to 170C and line a 20cm square tin. Melt the butter with the brown sugar and golden syrup.",
     "min": 5
    },
    {
     "text": "Stir into the flour, bicarb, ginger and cinnamon with the egg and milk. Pour into the tin.",
     "min": 8
    },
    {
     "text": "Bake until firm.",
     "min": 35
    },
    {
     "text": "Cool in the tin.",
     "min": 30
    },
    {
     "text": "Mix the icing sugar with the lemon juice, glaze the top and cut into squares.",
     "min": 10
    }
   ],
