     "item": "thickened cream",
     "aisle": "Dairy"
    },
    {
     "q": null,
     "u": "",
     "item": "salt, to taste",
     "aisle": "Pantry"
    }
   ],
   "steps": [
    {
     "text": "Cut the potatoes into thin frites, rinse and dry thoroughly.",
     "min": 15
    },
    {
     "text": "Fry in 140C oil until cooked but pale, drain and cool.",
     "min": 5
    },
    {
     "text": "While the frites cool, season the steaks.",
     "min": 15
    },
    {
     "text": "Fry the frites again at 185C until crisp. Season with salt.",
     "min": 3
    },
    {
     "text": "Sear the steaks in a heavy hot pan with oil on both sides.",
     "min": 6
    },
    {
     "text": "Lower the heat, add the butter and thyme and baste briefly, then rest the steaks.",
     "min": 9
    },
    {
     "text": "Add the peppercorns to the pan, then the brandy, carefully and away from the flame, and simmer briefly.",
     "min": 1
    },
    {
     "text": "Add the stock and reduce, then stir in the cream and simmer. Serve with the steaks and frites.",
     "min": 8
    }
   ],
