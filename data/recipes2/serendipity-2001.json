  {
   "n": "Gingerbread squares",
   "course": "s",
   "prep_min": 23,
   "cook_min": 65,
   "make_ahead": "Up to 3 days, airtight",
   "ingredients": [
    {
     "q": 125,
     "u": "g",
     "item": "butter",
     "aisle": "Dairy"
    },
    {
     "q": 100,
     "u": "g",
     "item": "brown sugar",
     "aisle": "Pantry"
    },
    {
     "q": 150,
     "u": "g",
     "item": "golden syrup",
     "aisle": "Pantry"
