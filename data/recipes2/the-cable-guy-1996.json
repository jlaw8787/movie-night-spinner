  {
   "n": "Roast tomato bisque, drunk from the bowl",
   "course": "s",
   "prep_min": 15,
   "cook_min": 45,
   "make_ahead": "Make the soup up to 3 days ahead and reheat; make the basil oil on the day",
   "ingredients": [
    {
     "q": 1.2,
     "u": "kg",
     "item": "ripe tomatoes, halved",
     "aisle": "Produce"
    },
    {
     "q": 1,
     "u": "",
     "item": "brown onion, quartered",
     "aisle": "Produce"
    },
    {
     "q": 4,
     "u": "",
     "item": "garlic cloves, unpeeled",
     "aisle": "Produce"
    },
    {
     "q": 3,
     "u": "tbsp",
     "item": "olive oil",
     "aisle": "Pantry"
    },
    {
     "q": 500,
     "u": "ml",
     "item": "vegetable stock",
     "aisle": "Pantry"
    },
    {
     "q": 1,
     "u": "tsp",
     "item": "caster sugar",
     "aisle": "Pantry"
    },
    {
     "q": 150,
     "u": "ml",
     "item": "thickened cream",
     "aisle": "Dairy"
    },
    {
     "q": 1,
     "u": "cup",
     "item": "basil leaves",
     "aisle": "Produce"
    },
    {
     "q": 60,
     "u": "ml",
     "item": "extra virgin olive oil",
     "aisle": "Pantry"
    }
   ],
   "steps": [
    {
     "text": "Toss the tomatoes, onion and garlic with the olive oil and salt and roast at 220C until soft and charred at the edges.",
     "min": 35
    },
    {
     "text": "Squeeze the garlic from its skins and blend everything with the stock and sugar until smooth.",
     "min": 6
    },
    {
     "text": "Warm through, stir in the cream and season.",
     "min": 6
    },
    {
     "text": "Blitz the basil with the extra virgin oil and a pinch of salt, and swirl over the soup in mugs.",
     "min": 8
    },
    {
     "text": "Hand it over in mugs or bowls you can drink from. No spoons.",
     "min": 5
    }
   ],
   "veg": true,
   "af": true
