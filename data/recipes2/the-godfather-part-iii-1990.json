   "n": "Palermo panelle",
   "course": "s",
   "prep_min": 15,
   "cook_min": 70,
   "make_ahead": "Set up to 1 day ahead, keep chilled; fry just before serving",
   "ingredients": [
    {
     "q": 250,
     "u": "g",
     "item": "chickpea flour",
     "aisle": "Pantry"
    },
    {
     "q": 750,
     "u": "ml",
     "item": "cold water",
     "aisle": "Pantry"
    },
    {
     "q": 1,
     "u": "tsp",
     "item": "salt",
     "aisle": "Pantry"
    },
    {
     "q": 2,
     "u": "tbsp",
     "item": "chopped parsley",
     "aisle": "Produce"
    },
    {
     "q": 500,
     "u": "ml",
     "item": "neutral oil, for frying",
     "aisle": "Pantry"
    },
    {
     "q": 2,
     "u": "",
     "item": "lemons, cut in wedges",
     "aisle": "Produce"
    },
    {
     "q": null,
     "u": "",
     "item": "flaky salt, to finish",
     "aisle": "Pantry"
    }
   ],
   "steps": [
    {
     "text": "Whisk the chickpea flour into the cold water with the salt until smooth.",
     "min": 3
    },
    {
     "text": "Cook over medium heat, stirring constantly, until very thick.",
     "min": 10
    },
    {
     "text": "Stir in the parsley and spread 1cm thick on an oiled tray. Leave to set for 1 hour.",
     "min": 60
    },
    {
     "text": "Cut into squares and fry in 180C oil in batches until puffed and golden.",
     "min": 10
    },
    {
     "text": "Drain, salt and serve with lemon wedges.",
     "min": 2
    }
   ]
