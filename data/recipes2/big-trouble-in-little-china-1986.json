     "item": "spring onions, sliced",
     "aisle": "Produce"
    }
   ],
   "steps": [
    {
     "text": "Put a large pot of water on to boil. Slice the spring onions and rinse and chop the mustard greens.",
     "min": 5
    },
    {
     "text": "Heat the vegetable oil in a wok and fry the pork mince with the mustard greens and Sichuan pepper over high heat for 8 minutes until crisp and dry.",
     "min": 8
