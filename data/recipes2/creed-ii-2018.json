     "item": "salt and pepper, to taste",
     "aisle": "Pantry"
    }
   ],
   "steps": [
    {
     "text": "Grate the potatoes and onion on the coarse side of a grater.",
     "min": 8
    },
    {
     "text": "Tip into a clean tea towel and squeeze out as much liquid as you can.",
     "min": 4
    },
    {
     "text": "Mix with the egg, flour and plenty of salt and pepper.",
     "min": 3
    },
    {
     "text": "Heat the oil in a large frying pan and fry heaped spoonfuls, flattened, for 3 to 4 minutes a side, in batches, until deep golden and crisp. Drain.",
     "min": 20
