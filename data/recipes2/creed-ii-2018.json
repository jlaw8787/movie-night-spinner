   "n": "Moscow fight night honey cake",
   "course": "w",
   "prep_min": 40,
   "cook_min": 531,
   "make_ahead": "Assemble 1 day ahead, the overnight chill is what softens the layers; keeps 3 days in the fridge",
   "ingredients": [
    {
     "q": 100,
     "u": "g",
     "item": "honey",
     "aisle": "Pantry"
    },
    {
     "q": 100,
     "u": "g",
     "item": "caster sugar",
     "aisle": "Pantry"
    },
    {
     "q": 80,
     "u": "g",
     "item": "butter",
     "aisle": "Dairy"
    },
    {
     "q": 2,
     "u": "",
     "item": "eggs",
     "aisle": "Dairy"
    },
    {
     "q": 1,
     "u": "tsp",
     "item": "bicarbonate of soda",
     "aisle": "Pantry"
    },
    {
     "q": 350,
     "u": "g",
     "item": "plain flour",
     "aisle": "Pantry"
    },
    {
     "q": 300,
     "u": "ml",
     "item": "thickened cream",
     "aisle": "Dairy"
    },
    {
     "q": 500,
     "u": "g",
     "item": "sour cream",
     "aisle": "Dairy"
    },
    {
     "q": 100,
     "u": "g",
     "item": "icing sugar",
     "aisle": "Pantry"
    }
   ],
   "steps": [
    {
     "text": "Melt the honey, caster sugar and butter in a bowl over simmering water.",
     "min": 8
    },
    {
     "text": "Whisk in the eggs, then the bicarb, until it foams and turns golden. Off the heat, work in the flour to a soft dough.",
     "min": 8
    },
    {
     "text": "Cover and rest until cool enough to handle. Heat the oven to 180C.",
     "min": 15
    },
    {
     "text": "Divide into 6, roll each thinly on baking paper, cut to a 20cm round using a plate and bake each for about 6 minutes until golden. Keep the offcuts and bake them too.",
     "min": 40
    },
    {
     "text": "Blitz the offcuts to fine crumbs.",
     "min": 5
    },
    {
     "text": "Whip the cream to soft peaks, then whisk in the sour cream and icing sugar.",
     "min": 5
    },
    {
     "text": "Stack the layers with the cream between each, cover the top and sides and press on the crumbs.",
     "min": 10
    },
    {
     "text": "Chill overnight.",
     "min": 480
    }
   ],
