   "course": "s",
   "prep_min": 15,
   "cook_min": 22,
   "make_ahead": "Best fried just before serving; mix the dill sour cream up to 2 days ahead. Keep fried deruny crisp in a 120C oven for up to 30 minutes",
   "ingredients": [
    {
     "q": 800,
     "u": "g",
