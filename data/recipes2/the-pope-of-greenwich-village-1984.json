  {
   "n": "Bed Bug Eddie's clams oreganata",
   "course": "s",
   "prep_min": 15,
   "cook_min": 0,
   "make_ahead": "Top up to 3 hours ahead, keep chilled; grill to serve",
   "ingredients": [
    {
     "q": 1,
     "u": "kg",
     "item": "clams",
     "aisle": "Seafood"
    },
    {
     "q": 60,
     "u": "g",
     "item": "breadcrumbs",
     "aisle": "Pantry"
    },
    {
     "q": 2,
     "u": "",
     "item": "garlic cloves, crushed",
     "aisle": "Produce"
    },
    {
     "q": 1,
     "u": "tsp",
     "item": "dried oregano",
     "aisle": "Spices"
    },
    {
     "q": 30,
     "u": "g",
     "item": "parmesan, grated",
     "aisle": "Dairy"
    },
    {
     "q": 3,
     "u": "tbsp",
     "item": "olive oil",
     "aisle": "Pantry"
    },
    {
     "q": 2,
     "u": "tbsp",
     "item": "water",
     "aisle": "Pantry"
    }
   ],
   "steps": [
    {
     "text": "Steam the clams with a splash of water in a covered pan until they open, about 4 minutes. Discard any that stay closed.",
     "min": 6
    },
    {
     "text": "Remove the top shells.",
     "min": 3
    },
    {
     "text": "Mix the breadcrumbs, garlic, oregano, parmesan and olive oil and top each clam.",
     "min": 3
    },
    {
     "text": "Grill for 3 minutes until golden.",
     "min": 3
    }
   ],
   "veg": false,
   "af": true
