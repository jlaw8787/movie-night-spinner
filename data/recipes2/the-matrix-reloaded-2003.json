  {
   "n": "The Merovingian's chocolate cake",
   "course": "w",
   "prep_min": 98,
   "cook_min": 38,
   "make_ahead": "Bake and glaze up to 2 days ahead and keep covered somewhere cool; bring to room temperature before slicing",
   "ingredients": [
    {
     "q": 200,
     "u": "g",
     "item": "dark chocolate, chopped, for the cake",
     "aisle": "Pantry"
    },
    {
     "q": 150,
     "u": "g",
     "item": "butter",
     "aisle": "Dairy"
    },
    {
     "q": 4,
     "u": "",
     "item": "eggs",
     "aisle": "Dairy"
    },
    {
     "q": 150,
     "u": "g",
     "item": "caster sugar",
     "aisle": "Pantry"
    },
    {
     "q": 50,
     "u": "g",
     "item": "almond meal",
     "aisle": "Pantry"
    },
    {
     "q": 30,
     "u": "g",
     "item": "plain flour",
     "aisle": "Pantry"
    },
    {
     "q": 2,
     "u": "tbsp",
     "item": "cocoa powder",
     "aisle": "Pantry"
    },
    {
     "q": null,
     "u": "",
     "item": "salt, a pinch",
     "aisle": "Pantry"
    },
    {
     "q": 100,
     "u": "g",
     "item": "dark chocolate, chopped, for the ganache",
     "aisle": "Pantry"
    },
    {
     "q": 100,
     "u": "ml",
     "item": "thickened cream",
     "aisle": "Dairy"
    }
   ],
   "steps": [
    {
     "text": "Heat the oven to 170C and grease and line a 20cm round tin.",
     "min": 5
    },
    {
     "text": "Melt the chocolate for the cake with the butter in a bowl over simmering water, stirring until smooth.",
     "min": 8
    },
    {
     "text": "Whisk the eggs and sugar until pale and thick.",
     "min": 6
    },
    {
     "text": "Fold in the chocolate, then the almond meal, flour, cocoa and salt.",
     "min": 5
    },
    {
     "text": "Bake for 30 minutes until just set with a slight wobble in the middle.",
     "min": 30
    },
    {
     "text": "Cool completely in the tin.",
     "min": 60
    },
    {
     "text": "Bring the cream to a simmer, pour over the ganache chocolate, stand 2 minutes and stir until glossy. Pour over the cake and leave to set.",
     "min": 20
    },
    {
     "text": "Slice with a hot knife.",
     "min": 2
    }
   ],
   "veg": true,
