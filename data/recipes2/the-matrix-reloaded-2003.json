{
 "serves": 4,
 "dishes": [
  {
   "n": "Le Vrai gruyère gougères",
   "course": "s",
   "prep_min": 25,
   "cook_min": 31,
   "make_ahead": "Bake up to 1 day ahead and recrisp at 180C for 5 minutes, or freeze the raw mounds and bake from frozen",
   "ingredients": [
    {
     "q": 125,
     "u": "ml",
     "item": "water",
     "aisle": "Pantry"
    },
    {
     "q": 60,
     "u": "g",
     "item": "butter, diced",
     "aisle": "Dairy"
    },
    {
     "q": 0.5,
     "u": "tsp",
     "item": "salt",
     "aisle": "Pantry"
    },
    {
     "q": 75,
     "u": "g",
     "item": "plain flour",
     "aisle": "Pantry"
    },
    {
     "q": 2,
     "u": "",
     "item": "eggs",
     "aisle": "Dairy"
    },
    {
     "q": 80,
     "u": "g",
     "item": "gruyère, finely grated",
     "aisle": "Dairy"
    },
    {
     "q": null,
     "u": "",
     "item": "nutmeg, a pinch",
     "aisle": "Spices"
    },
    {
     "q": 0.25,
     "u": "tsp",
     "item": "black pepper",
     "aisle": "Spices"
    }
   ],
   "steps": [
    {
     "text": "Heat the oven to 200C, line 2 trays and grate the gruyère.",
     "min": 5
    },
    {
     "text": "Bring the water, butter and salt to the boil. Tip in the flour all at once and beat over the heat for 2 minutes until the dough pulls away from the pan.",
     "min": 6
    },
    {
     "text": "Tip into a bowl and cool for 5 minutes.",
     "min": 5
    },
    {
     "text": "Beat in the eggs one at a time until glossy, then 60g of the gruyère, the nutmeg and pepper.",
     "min": 6
    },
    {
     "text": "Spoon or pipe 20 walnut-sized mounds onto the trays and top with the rest of the cheese.",
     "min": 8
    },
    {
     "text": "Bake for 25 minutes until puffed and deep golden, without opening the oven for the first 15.",
     "min": 25
    },
    {
     "text": "Serve warm.",
     "min": 1
    }
   ],
   "veg": true,
   "af": true
  },
  {
   "n": "Zion temple flatbreads with smoked eggplant",
   "course": "s",
   "prep_min": 23,
   "cook_min": 26,
   "make_ahead": "Make the dip up to 2 days ahead and keep chilled; warm the flatbreads just before serving",
   "ingredients": [
    {
     "q": 2,
     "u": "",
     "item": "large eggplants",
     "aisle": "Produce"
    },
    {
     "q": 3,
     "u": "tbsp",
     "item": "tahini",
     "aisle": "Pantry"
    },
    {
     "q": 1,
     "u": "",
     "item": "lemon, juiced",
     "aisle": "Produce"
    },
    {
     "q": 1,
     "u": "",
     "item": "garlic clove, crushed",
     "aisle": "Produce"
    },
    {
     "q": 4,
     "u": "tbsp",
     "item": "extra virgin olive oil",
     "aisle": "Pantry"
    },
    {
     "q": null,
     "u": "",
     "item": "salt, to taste",
     "aisle": "Pantry"
    },
    {
     "q": 0.5,
     "u": "tsp",
     "item": "smoked paprika",
     "aisle": "Spices"
    },
    {
     "q": 1,
     "u": "tbsp",
     "item": "parsley, chopped",
     "aisle": "Produce"
    },
    {
     "q": 4,
     "u": "",
     "item": "flatbreads or pita",
     "aisle": "Bakery"
    }
   ],
   "steps": [
    {
     "text": "Char the eggplants over a gas flame or under a very hot grill, turning, until black and collapsed.",
     "min": 20
    },
    {
     "text": "Put them in a bowl, cover with a plate and steam for 10 minutes.",
     "min": 10
    },
    {
     "text": "Peel off the skin, chop the flesh and drain in a sieve.",
     "min": 5
    },
    {
     "text": "Mash with the tahini, lemon juice, garlic, 2 tbsp of the oil and salt to taste.",
     "min": 5
    },
    {
     "text": "Warm the flatbreads in a hot dry pan and brush with 1 tbsp of the oil.",
     "min": 6
    },
    {
     "text": "Spoon the dip into a bowl, drizzle with the last of the oil, dust with smoked paprika and parsley and serve with the torn bread.",
     "min": 3
    }
   ],
   "veg": true,
   "af": true
  },
