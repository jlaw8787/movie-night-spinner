     "q": 500,
     "u": "ml",
     "item": "full cream milk, for the café",
     "aisle": "Dairy"
    }
   ],
   "steps": [
    {
     "text": "Mix the yeast, caster sugar and warm milk and stand for 10 minutes until foamy.",
     "min": 10
    },
    {
     "text": "Beat in the egg, melted butter, plain flour and a pinch of salt to a soft dough and knead for 3 minutes.",
     "min": 5
    },
    {
     "text": "Cover and leave to rise for 1 hour.",
     "min": 60
    },
    {
     "text": "Roll the dough 5mm thick and cut into 6cm squares. Heat the oil to 175C and fry the squares for 1 minute a side until puffed and golden.",
     "min": 15
