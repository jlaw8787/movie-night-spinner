   ],
   "steps": [
    {
     "text": "Heat the oven to 220C.",
     "min": 5
    },
    {
     "text": "Divide the pizza dough into equal pieces and roll into 80cm ropes.",
     "min": 5
    },
    {
     "text": "Twist into pretzel shapes.",
