  {
   "n": "Cafe 80's fries",
   "course": "s",
   "prep_min": 15,
   "cook_min": 45,
   "make_ahead": "Fries can be soaked up to 4 hours ahead, fry just before serving",
   "ingredients": [
    {
     "q": 4,
     "u": "",
     "item": "large potatoes",
     "aisle": "Produce"
    },
    {
     "q": 2,
     "u": "l",
     "item": "vegetable oil",
     "aisle": "Pantry"
    },
    {
     "q": 1,
     "u": "tsp",
     "item": "fine salt",
     "aisle": "Pantry"
    },
    {
     "q": 1,
     "u": "tsp",
     "item": "smoked paprika",
     "aisle": "Spices"
    }
   ],
   "steps": [
    {
     "text": "Spiralise the potatoes and soak in cold water so the starch rinses out.",
     "min": 30
    },
    {
     "text": "Drain and dry very well on clean tea towels, any water will spit in the oil.",
     "min": 5
    },
    {
     "text": "Heat the oil to 180C and fry in batches until crisp and golden.",
     "min": 12
    },
    {
     "text": "Mix the salt with the smoked paprika, toss through the hot fries and serve straight away.",
     "min": 3
    }
   ],
