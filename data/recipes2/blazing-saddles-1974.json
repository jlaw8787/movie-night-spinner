    {
     "q": 100,
     "u": "g",
     "item": "butter",
     "aisle": "Dairy"
    },
    {
     "q": 1,
     "u": "",
     "item": "long red chilli, finely chopped",
     "aisle": "Produce"
    }
   ],
   "steps": [
    {
     "text": "Heat the oven to 210C with a 25cm cast iron pan inside.",
     "min": 10
    },
    {
     "text": "Mix the polenta, flour, baking powder and salt. Whisk the eggs into the buttermilk with 60g of the butter, melted, then stir into the dry mix.",
     "min": 6
    },
    {
     "text": "Take out the hot pan, swirl in a knob of butter and pour in the batter.",
     "min": 2
    },
    {
     "text": "Bake 20 to 22 minutes until golden and a skewer comes out clean.",
     "min": 22
    },
    {
     "text": "Mash the rest of the butter with the chilli and a pinch of salt, and serve the cornbread in wedges with it.",
     "min": 3
    }
