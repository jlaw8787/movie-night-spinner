{
 "serves": 4,
 "dishes": [
  {
   "n": "Cammareri Bros. rosemary focaccia",
   "course": "s",
   "prep_min": 20,
   "cook_min": 180,
   "make_ahead": "Best the day it is baked; keeps 1 day airtight",
   "ingredients": [
    {
     "q": 500,
     "u": "g",
     "item": "bread flour",
     "aisle": "Pantry"
    },
    {
     "q": 7,
     "u": "g",
     "item": "dried yeast",
     "aisle": "Pantry"
    },
    {
     "q": 10,
     "u": "g",
     "item": "salt",
     "aisle": "Pantry"
    },
    {
     "q": 400,
     "u": "ml",
     "item": "warm water",
     "aisle": "Pantry"
    },
    {
     "q": 90,
     "u": "ml",
     "item": "olive oil, divided",
     "aisle": "Pantry"
    },
    {
     "q": 3,
     "u": "",
     "item": "sprigs rosemary, leaves picked",
     "aisle": "Produce"
    },
    {
     "q": null,
     "u": "",
     "item": "flaky salt, to finish",
     "aisle": "Pantry"
    }
   ],
   "steps": [
    {
     "text": "Mix the flour, yeast, salt and warm water into a wet dough. Cover and rise for 2 hours.",
     "min": 120
    },
    {
     "text": "Oil a 30 x 20cm tin with most of the oil, tip in the dough and stretch to the corners. Rest for 30 minutes.",
     "min": 35
    },
    {
     "text": "Dimple deeply with oiled fingers, scatter with rosemary and flaky salt and drizzle with the remaining oil.",
     "min": 5
    },
    {
     "text": "Bake at 230C until deep golden.",
     "min": 24
    }
   ],
   "veg": true,
   "af": true
  },
  {
   "n": "Eggs in the hole",
   "course": "m",
   "prep_min": 5,
   "cook_min": 10,
   "make_ahead": "",
   "ingredients": [
    {
     "q": 4,
     "u": "",
     "item": "thick slices white bread",
     "aisle": "Bakery"
    },
    {
     "q": 40,
     "u": "g",
     "item": "butter",
     "aisle": "Dairy"
    },
    {
     "q": 1,
     "u": "",
     "item": "red capsicum, cut in 4 thick rings",
     "aisle": "Produce"
    },
    {
     "q": 4,
     "u": "",
     "item": "eggs",
     "aisle": "Dairy"
    },
    {
     "q": null,
     "u": "",
     "item": "salt and pepper, to taste",
     "aisle": "Spices"
    }
   ],
   "steps": [
    {
     "text": "Cut a hole in each slice of bread.",
     "min": 2
    },
    {
     "text": "Melt the butter in a big pan and lay in the bread. Put a capsicum ring in each hole and crack an egg into it.",
     "min": 3
    },
    {
     "text": "Fry until the white sets, flipping the bread once. Season.",
     "min": 7
    }
   ],
   "veg": true,
   "af": true
  },
