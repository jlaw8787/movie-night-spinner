    {
     "q": 150,
     "u": "ml",
     "item": "thickened cream",
     "aisle": "Dairy"
    }
   ],
   "steps": [
    {
     "text": "Melt the chocolate with the butter and cool slightly.",
     "min": 8
    },
    {
     "text": "Separate the eggs and whisk the yolks into the chocolate.",
     "min": 3
    },
    {
     "text": "Whip the egg whites to soft peaks with the sugar.",
     "min": 7
    },
    {
     "text": "Softly whip the cream.",
     "min": 5
    },
    {
     "text": "Fold the cream, then the whites, through the chocolate.",
     "min": 7
    },
    {
     "text": "Spoon into glasses and chill until set. This chilling counts toward the cooking time.",
     "min": 240
    }
   ],
