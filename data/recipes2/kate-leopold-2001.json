   ],
   "steps": [
    {
     "text": "Brown 100g of the butter in a pan until nutty.",
     "min": 6
    },
    {
     "text": "Cool the browned butter, then whip with the honey.",
     "min": 30
    },
    {
     "text": "Set out the cultured butter, salted Irish butter and whipped brown butter in small dishes.",
     "min": 3
    },
    {
     "text": "Warm the sourdough loaf at 180C for 8 minutes and slice.",
     "min": 8
    },
    {
     "text": "Halve the radishes and serve with the flaky salt for dipping, alongside the three butters and bread.",
