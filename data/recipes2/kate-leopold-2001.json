    {
     "q": null,
     "u": "",
     "item": "salt, to taste",
     "aisle": "Pantry"
    }
   ],
   "steps": [
    {
     "text": "Score the snapper on both sides, season with salt and stuff with the lemon slices, sliced fennel and dill.",
     "min": 12
    },
    {
     "text": "Roast the fish at 220C for 25 minutes.",
     "min": 25
    },
    {
     "text": "While the fish roasts, boil the new potatoes in salted water until tender, about 20 minutes, then drain.",
     "min": 0
    },
    {
     "text": "Reduce the shallot with the white wine and white wine vinegar until about 2 tbsp is left.",
     "min": 8
    },
    {
     "text": "Take off the heat and whisk in the cold butter cube by cube until thick and glossy.",
     "min": 5
    },
    {
     "text": "Serve the fish with the potatoes and the sauce.",
     "min": 5
    }
