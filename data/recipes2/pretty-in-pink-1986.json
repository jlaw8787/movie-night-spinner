   ],
   "steps": [
    {
     "text": "Heat the oven to 180C and line two 12cm round tins. Cook the strawberries over low heat until reduced to a thick puree and cool.",
     "min": 12
    },
    {
     "text": "Beat part of the butter with the caster sugar until pale, beat in the eggs and fold in the flour.",
     "min": 8
