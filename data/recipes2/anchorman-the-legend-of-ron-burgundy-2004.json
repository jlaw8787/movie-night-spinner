  {
   "n": "ButterSCOTCH pudding",
   "course": "w",
   "prep_min": 20,
   "cook_min": 40,
   "make_ahead": "Make on the day, serve warm",
   "ingredients": [
    {
     "q": 60,
     "u": "g",
     "item": "butter",
     "aisle": "Dairy"
    },
    {
     "q": 150,
     "u": "g",
     "item": "self-raising flour",
     "aisle": "Pantry"
    },
    {
     "q": 175,
     "u": "g",
     "item": "dark brown sugar",
     "aisle": "Pantry"
    },
    {
     "q": 1,
     "u": "",
     "item": "pinch salt",
     "aisle": "Pantry"
    },
    {
     "q": 125,
     "u": "ml",
     "item": "full cream milk",
     "aisle": "Dairy"
    },
    {
     "q": 1,
     "u": "",
     "item": "egg",
     "aisle": "Dairy"
    },
    {
     "q": 1,
     "u": "tsp",
     "item": "vanilla extract",
     "aisle": "Pantry"
    },
    {
     "q": 1,
     "u": "tbsp",
     "item": "cornflour",
     "aisle": "Pantry"
    },
    {
     "q": 2,
     "u": "tbsp",
     "item": "golden syrup",
     "aisle": "Pantry"
    },
    {
     "q": 250,
     "u": "ml",
     "item": "boiling water",
     "aisle": "Pantry"
    },
    {
     "q": 500,
     "u": "ml",
     "item": "vanilla ice cream",
     "aisle": "Frozen"
    }
   ],
   "steps": [
    {
     "text": "Heat the oven to 180C conventional and grease a deep 1.5L baking dish with a little of the butter.",
     "min": 5
    },
    {
     "text": "Whisk the flour with part of the sugar and the salt, then whisk melted butter, milk, egg and vanilla in another bowl and fold together just until combined.",
     "min": 5
    },
    {
     "text": "Spread into the dish. Mix the rest of the sugar with the cornflour and sprinkle over the batter.",
     "min": 5
    },
    {
     "text": "Dissolve the golden syrup in the boiling water and pour gently over the back of a spoon without stirring.",
     "min": 5
    },
    {
     "text": "Bake on a tray until the sponge is set and a skewer in the sponge comes out clean. The sauce stays underneath.",
     "min": 33
    },
    {
     "text": "Rest, then scoop into bowls with the warm butterscotch sauce and vanilla ice cream. All the butterscotch flavour, no whisky.",
     "min": 5
    }
   ],
   "veg": true,
   "af": true
