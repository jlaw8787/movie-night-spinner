  {
   "n": "Fist my bump arancini",
   "course": "s",
   "prep_min": 20,
   "cook_min": 30,
   "make_ahead": "Make the risotto up to 2 days ahead and chill; roll, crumb and fry to serve",
   "ingredients": [
    {
     "q": 30,
     "u": "g",
     "item": "butter",
     "aisle": "Dairy"
    },
    {
     "q": 1,
     "u": "",
     "item": "brown onion, finely diced",
     "aisle": "Produce"
    },
    {
     "q": 250,
     "u": "g",
     "item": "arborio rice",
     "aisle": "Pantry"
    },
    {
     "q": 800,
     "u": "ml",
     "item": "hot vegetable stock",
     "aisle": "Pantry"
    },
    {
     "q": 60,
     "u": "g",
     "item": "parmesan, finely grated",
     "aisle": "Dairy"
    },
    {
     "q": 0.5,
     "u": "cup",
     "item": "frozen peas",
     "aisle": "Frozen"
    },
    {
     "q": 100,
     "u": "g",
     "item": "mozzarella, cut in small cubes",
     "aisle": "Dairy"
    },
    {
     "q": 2,
     "u": "",
     "item": "eggs, beaten",
     "aisle": "Dairy"
    },
    {
     "q": 100,
     "u": "g",
     "item": "panko breadcrumbs",
     "aisle": "Pantry"
    },
    {
     "q": 1,
     "u": "l",
     "item": "vegetable oil, for frying",
     "aisle": "Pantry"
    }
   ],
   "steps": [
    {
     "text": "Soften the onion in the butter, stir in the rice, then add the stock a ladle at a time until creamy and tender.",
     "min": 20
    },
    {
     "text": "Stir in the parmesan and peas, spread on a tray and chill until firm.",
     "min": 5
    },
    {
     "text": "Roll into 12 balls around a cube of mozzarella, dip in egg and roll in panko.",
     "min": 15
    },
    {
     "text": "Fry at 180C until golden and hot in the middle.",
     "min": 10
    }
   ],
   "veg": true,
   "af": true
