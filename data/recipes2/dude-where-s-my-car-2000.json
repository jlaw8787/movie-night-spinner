     "item": "vegetable oil",
     "aisle": "Pantry"
    }
   ],
   "steps": [
    {
     "text": "Fry the pork mince until browned, add the finely shredded cabbage, the grated carrot, the crushed garlic cloves, the oyster sauce and the soy, and cook 3 minutes.",
     "min": 3
    },
    {
     "text": "Cool completely.",
     "min": 3
    },
    {
     "text": "Roll the filling in each of the spring roll wrappers, sealing the edge with a little water.",
     "min": 3
    },
    {
     "text": "Deep fry at 180C for 3 to 4 minutes until golden, then drain on paper towel.",
     "min": 4
    },
    {
     "text": "Stir the juice of the lime into the sweet chilli sauce and serve with coriander.",
     "min": 2
    }
