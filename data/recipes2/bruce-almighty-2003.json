  {
   "n": "Pulled-closer half-moon pierogi",
   "course": "s",
   "prep_min": 60,
   "cook_min": 38,
   "make_ahead": "Fill and shape the pierogi up to a day ahead and chill on a floured tray, or freeze; boil and fry to serve",
   "ingredients": [
    {
     "q": 300,
     "u": "g",
     "item": "plain flour, plus extra for rolling",
     "aisle": "Pantry"
    },
    {
     "q": 1,
     "u": "",
     "item": "egg",
     "aisle": "Dairy"
    },
    {
     "q": 150,
     "u": "g",
     "item": "sour cream, plus extra to serve",
     "aisle": "Dairy"
    },
    {
     "q": 100,
     "u": "g",
     "item": "butter",
     "aisle": "Dairy"
    },
    {
     "q": 500,
     "u": "g",
     "item": "floury potatoes, peeled and chopped",
     "aisle": "Produce"
    },
    {
     "q": 120,
     "u": "g",
     "item": "vintage cheddar, grated",
     "aisle": "Dairy"
    },
    {
     "q": 2,
     "u": "",
     "item": "brown onions, 1 finely diced, 1 thinly sliced",
     "aisle": "Produce"
    },
    {
     "q": 1,
     "u": "tbsp",
     "item": "chives, snipped",
     "aisle": "Produce"
    }
   ],
   "steps": [
    {
     "text": "Mix the flour, egg, 3 tbsp sour cream, 30g melted butter and half a teaspoon of salt into a soft dough, knead 3 minutes and rest under a bowl.",
     "min": 30
    },
    {
     "text": "Boil the potatoes until soft, mash with the cheddar, fry the diced onion in a little butter and stir it through. Season hard and cool.",
     "min": 25
    },
    {
     "text": "Roll the dough 2mm thick, cut 8cm rounds, fill each with a teaspoon of potato, fold into half moons and pinch the edges shut.",
     "min": 25
    },
    {
     "text": "Boil the pierogi in salted water until they float, then 1 minute more, and lift out.",
     "min": 8
    },
    {
     "text": "Fry the sliced onion in the rest of the butter until golden, add the pierogi and fry until crisp at the edges. Serve with sour cream and chives.",
     "min": 10
    }
   ],
   "veg": true,
   "af": true
  },
