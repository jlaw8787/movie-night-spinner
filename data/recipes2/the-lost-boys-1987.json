  {
   "n": "Santa Carla boardwalk fries",
   "course": "s",
   "prep_min": 20,
   "cook_min": 45,
   "make_ahead": "Fries can be soaked up to 4 hours ahead",
   "ingredients": [
    {
     "q": 1,
     "u": "kg",
     "item": "russet potatoes",
     "aisle": "Produce"
    },
    {
     "q": 2,
     "u": "l",
     "item": "vegetable oil",
     "aisle": "Pantry"
    },
    {
     "q": 1,
     "u": "tsp",
     "item": "fine salt",
     "aisle": "Pantry"
    },
    {
     "q": 1,
     "u": "tsp",
     "item": "garlic powder",
     "aisle": "Spices"
    },
    {
     "q": 0.25,
     "u": "cup",
     "item": "parsley, chopped",
     "aisle": "Produce"
    }
   ],
   "steps": [
    {
     "text": "Cut the potatoes into thin fries. Soak in cold water, then drain and dry very well",
     "min": 30
    },
    {
     "text": "Fry in batches in oil at 140C for about 5 minutes until pale and soft, then rest on a rack",
     "min": 12
    },
    {
     "text": "Reheat the oil to 190C and fry again until golden and crisp",
     "min": 8
    },
    {
     "text": "Toss with salt, garlic powder and parsley and serve in paper cones",
     "min": 2
    }
   ],
