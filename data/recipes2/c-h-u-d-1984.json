    {
     "q": 150,
     "u": "g",
     "item": "sharp cheddar, grated",
     "aisle": "Dairy"
    }
   ],
   "steps": [
    {
     "text": "Fry the onion in some of the butter until golden.",
     "min": 15
    },
    {
     "text": "Mix the flour, yeast, salt, sugar, warm milk and the rest of the melted butter. Knead.",
     "min": 12
