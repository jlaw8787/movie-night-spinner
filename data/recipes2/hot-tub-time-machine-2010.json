     "u": "tbsp",
     "item": "cornflour",
     "aisle": "Pantry"
    },
    {
     "q": 1,
     "u": "tbsp",
     "item": "kirsch",
     "aisle": "Drinks"
    },
    {
     "q": null,
     "u": "",
     "item": "nutmeg, to taste",
     "aisle": "Spices"
    },
    {
     "q": 1,
     "u": "",
     "item": "baguette",
     "aisle": "Bakery"
    },
    {
     "q": 500,
     "u": "g",
     "item": "baby potatoes",
     "aisle": "Produce"
    },
    {
     "q": 1,
     "u": "",
     "item": "jar cornichons",
     "aisle": "Meat"
    }
   ],
   "steps": [
    {
     "text": "Rub a heavy pot with a halved garlic clove.",
     "min": 3
    },
    {
     "text": "Heat the dry white wine until just simmering.",
     "min": 12
    },
    {
     "text": "Toss the grated gruyère and the grated emmental with the cornflour and add a handful at a time, stirring in a figure eight until smooth.",
     "min": 4
    },
    {
     "text": "Stir in the kirsch or lemon juice and nutmeg.",
     "min": 2
    },
    {
     "text": "Keep warm over a burner and serve with the cubed baguette, the boiled baby potatoes and cornichons.",
     "min": 3
    }
   ]
