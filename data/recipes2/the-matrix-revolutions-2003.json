     "u": "tbsp",
     "item": "cornflour",
     "aisle": "Pantry"
    }
   ],
   "steps": [
    {
     "text": "Butter a 1.2 litre pudding basin and spoon the golden syrup into the base.",
     "min": 3
    },
    {
     "text": "Cream the butter and sugar until pale.",
     "min": 5
    },
    {
     "text": "Beat in the eggs one at a time, then fold in the flour, lemon zest and milk.",
