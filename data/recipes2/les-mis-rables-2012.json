  {
   "n": "Valjean's loaf with salted butter and radishes",
   "course": "s",
   "prep_min": 15,
   "cook_min": 215,
   "make_ahead": "Bake up to 1 day ahead and keep in a paper bag; refresh at 200C for 5 minutes. Soften the butter and trim the radishes up to 4 hours ahead",
   "ingredients": [
    {
     "q": 500,
     "u": "g",
     "item": "bread flour, plus extra for dusting",
     "aisle": "Pantry"
    },
    {
     "q": 7,
     "u": "g",
     "item": "dried yeast",
     "aisle": "Pantry"
    },
    {
     "q": 10,
     "u": "g",
     "item": "salt",
     "aisle": "Spices"
    },
    {
     "q": 400,
     "u": "ml",
     "item": "warm water",
     "aisle": "Pantry"
    },
    {
     "q": 125,
     "u": "g",
     "item": "salted butter, softened",
     "aisle": "Dairy"
    },
    {
     "q": 1,
     "u": "",
     "item": "bunch radishes, trimmed",
     "aisle": "Produce"
    },
    {
     "q": 1,
     "u": "tsp",
     "item": "salt flakes",
     "aisle": "Spices"
    }
   ],
   "steps": [
    {
     "text": "Mix the flour, yeast, salt and warm water to a shaggy, sticky dough. No kneading.",
     "min": 5
    },
    {
     "text": "Cover and leave to rise until doubled and bubbly.",
     "min": 120
    },
    {
     "text": "Tip onto a well floured bench, fold the edges in to make a round and set it seam side down on floured baking paper.",
     "min": 5
    },
    {
     "text": "Heat the oven to 240C with a lidded cast iron pot inside while the loaf rests.",
     "min": 30
    },
    {
     "text": "Lift the loaf on its paper into the hot pot, slash the top and bake with the lid on, then lid off until dark and crusty.",
     "min": 40
    },
    {
     "text": "Cool on a rack, then tear and serve with the butter, radishes and salt flakes.",
     "min": 30
    }
   ],
   "veg": true,
   "af": true
  },
