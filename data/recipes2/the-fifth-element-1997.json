     "q": 1,
     "u": "",
     "item": "lemon",
     "aisle": "Produce"
    }
   ],
   "steps": [
    {
     "text": "Soften two gelatine leaves in cold water. Warm the coconut milk with some of the sugar and stir in the squeezed gelatine.",
     "min": 8
    },
    {
     "text": "Pour into four glasses and chill until set.",
     "min": 120
    },
    {
     "text": "Steep the butterfly pea flowers in the boiling water, strain and stir in the remaining sugar and two softened gelatine leaves.",
     "min": 12
    },
    {
     "text": "Cool, then pour gently over the set coconut layer and chill until set.",
     "min": 180
    },
    {
     "text": "At the table, squeeze lemon over the top and watch it turn purple.",
     "min": 2
    }
   ],
