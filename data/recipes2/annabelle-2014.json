  {
   "n": "Stovetop maple bacon brown butter popcorn",
   "course": "s",
   "prep_min": 10,
   "cook_min": 15,
   "make_ahead": "",
   "ingredients": [
    {
     "q": 4,
     "u": "",
     "item": "rashers streaky bacon",
     "aisle": "Meat"
    },
    {
     "q": 120,
     "u": "g",
     "item": "popcorn kernels",
     "aisle": "Pantry"
    },
    {
     "q": 2,
     "u": "tbsp",
     "item": "vegetable oil",
     "aisle": "Pantry"
    },
    {
     "q": 60,
     "u": "g",
     "item": "butter",
     "aisle": "Dairy"
    },
    {
     "q": 2,
     "u": "tbsp",
     "item": "maple syrup",
     "aisle": "Pantry"
    },
    {
     "q": 1,
     "u": "",
     "item": "pinch flaky sea salt",
     "aisle": "Spices"
    }
   ],
   "steps": [
    {
     "text": "Fry the bacon until very crisp, then crumble.",
     "min": 7
    },
    {
     "text": "Heat the oil in a heavy pot over medium heat, add the kernels, cover and shake constantly until the popping slows. Pull it off straight away.",
     "min": 6
    },
    {
     "text": "Cook the butter in a small pan until golden brown and nutty, then stir in the maple syrup.",
     "min": 4
    },
    {
     "text": "Pour over the popcorn and toss with the bacon and a good pinch of salt.",
     "min": 3
    }
   ],
