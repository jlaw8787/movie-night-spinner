   ],
   "steps": [
    {
     "text": "Heat the oven to 180C and line a muffin tin with 12 paper cases.",
     "min": 5
    },
    {
     "text": "Beat 125g butter with the caster sugar until pale, beat in the eggs, then fold in the flour, milk and vanilla.",
     "min": 8
