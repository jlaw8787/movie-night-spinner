  {
   "n": "Little Red's basket cheese and herb buns",
   "course": "s",
   "prep_min": 25,
   "cook_min": 117,
   "make_ahead": "Bake up to 1 day ahead and keep in an airtight tin; warm at 180C for 5 minutes. The dough can do its first prove overnight in the fridge",
   "ingredients": [
    {
     "q": 500,
     "u": "g",
     "item": "bread flour",
     "aisle": "Pantry"
    },
    {
     "q": 7,
     "u": "g",
     "item": "dried yeast",
     "aisle": "Pantry"
    },
    {
     "q": 1,
     "u": "tsp",
     "item": "caster sugar",
     "aisle": "Pantry"
    },
    {
     "q": 1,
     "u": "tsp",
     "item": "salt",
     "aisle": "Spices"
    },
    {
     "q": 300,
     "u": "ml",
     "item": "warm milk",
     "aisle": "Dairy"
    },
    {
     "q": 40,
     "u": "g",
     "item": "butter, softened",
     "aisle": "Dairy"
    },
    {
     "q": 150,
     "u": "g",
     "item": "cheddar, grated",
     "aisle": "Dairy"
    },
    {
     "q": 2,
     "u": "tbsp",
     "item": "chives, chopped",
     "aisle": "Produce"
    },
    {
     "q": 1,
     "u": "tsp",
     "item": "thyme leaves",
     "aisle": "Produce"
    },
    {
     "q": 1,
     "u": "",
     "item": "egg, beaten",
     "aisle": "Dairy"
    }
   ],
   "steps": [
    {
     "text": "Mix the flour, yeast, sugar, salt, warm milk and butter and knead for 10 minutes until smooth. Knead in two thirds of the cheddar with the chives and thyme.",
     "min": 12
    },
    {
     "text": "Cover and prove until doubled.",
     "min": 60
    },
    {
     "text": "Divide into 12 and roll into tight balls. Set them close together in a lined 23cm square tin.",
     "min": 10
    },
    {
     "text": "Cover and prove until puffy and touching. Heat the oven to 200C.",
     "min": 30
    },
    {
     "text": "Brush with the egg, scatter with the rest of the cheddar and bake until golden.",
     "min": 20
    },
    {
     "text": "Cool for 10 minutes, then pull apart into a cloth-lined basket.",
     "min": 10
    }
   ],
