     "q": 200,
     "u": "g",
     "item": "cheddar, grated",
     "aisle": "Dairy"
    },
    {
     "q": 40,
     "u": "g",
     "item": "butter, soft",
     "aisle": "Dairy"
    }
   ],
   "steps": [
    {
     "text": "Heat the oven to 200C. Toss 1kg halved tomatoes, the onion and garlic with 2 tbsp olive oil in a roasting tin.",
     "min": 5
    },
    {
     "text": "Roast until soft and catching at the edges.",
     "min": 35
    },
    {
     "text": "Blend with 500ml vegetable stock, the sugar and salt, then simmer in a pot.",
     "min": 10
    },
    {
     "text": "Butter the outsides of 8 slices of bread and fill 4 sandwiches with 200g grated cheddar.",
     "min": 5
    },
    {
     "text": "Toast in a frying pan over medium heat for 3 minutes a side until golden and melted, in batches.",
     "min": 12
    },
    {
     "text": "Cut into fingers and serve with the soup in cups.",
     "min": 3
    }
