   "n": "Lights-out tomato soup and cheese toasties",
   "course": "s",
   "prep_min": 10,
   "cook_min": 60,
   "make_ahead": "Make the soup up to 3 days ahead and reheat; build and toast the toasties on the night",
   "ingredients": [
