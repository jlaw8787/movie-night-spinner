     "q": 4,
     "u": "",
     "item": "eggs",
     "aisle": "Dairy"
    },
    {
     "q": 120,
     "u": "g",
     "item": "gruyere, finely grated",
     "aisle": "Dairy"
    },
    {
     "q": 1,
     "u": "tsp",
     "item": "Dijon mustard",
     "aisle": "Pantry"
