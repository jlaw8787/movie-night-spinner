    {
     "q": 1,
     "u": "tsp",
     "item": "thyme leaves",
     "aisle": "Produce"
    }
   ],
   "steps": [
    {
     "text": "Bring the water, milk, butter and a pinch of salt to the boil, tip in the flour and beat over the heat until it forms a smooth ball.",
     "min": 6
    },
    {
     "text": "Cool for 5 minutes, then beat in the eggs one at a time until glossy.",
     "min": 8
    },
    {
     "text": "Beat in 100g of the gruyere, the mustard, thyme and plenty of pepper.",
     "min": 2
    },
    {
     "text": "Pipe walnut-sized balls onto lined trays and top with the rest of the cheese.",
     "min": 6
    },
    {
     "text": "Bake at 200C until puffed, deep golden and crisp, and serve warm.",
     "min": 23
    }
