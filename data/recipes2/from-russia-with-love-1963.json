  {
   "n": "Kerim Bey's sesame simit",
   "course": "s",
   "prep_min": 120,
   "cook_min": 15,
   "make_ahead": "Bake up to 1 day ahead and warm at 180C for 5 minutes; the dough can also rise slowly in the fridge overnight",
   "ingredients": [
    {
     "q": 350,
     "u": "g",
     "item": "plain flour",
     "aisle": "Pantry"
    },
    {
     "q": 7,
     "u": "g",
     "item": "dried yeast",
     "aisle": "Pantry"
    },
    {
     "q": 1,
     "u": "tsp",
     "item": "sugar",
     "aisle": "Pantry"
    },
    {
     "q": 1,
     "u": "tsp",
     "item": "salt",
     "aisle": "Pantry"
    },
    {
     "q": 220,
     "u": "ml",
     "item": "warm water",
     "aisle": "Pantry"
    },
    {
     "q": 2,
     "u": "tbsp",
     "item": "olive oil",
     "aisle": "Pantry"
    },
    {
     "q": 80,
     "u": "ml",
     "item": "grape molasses or date syrup",
     "aisle": "Pantry"
    },
    {
     "q": 80,
     "u": "ml",
     "item": "water, for the dip",
     "aisle": "Pantry"
    },
    {
     "q": 120,
     "u": "g",
     "item": "sesame seeds",
     "aisle": "Pantry"
    },
    {
     "q": 200,
     "u": "g",
     "item": "feta",
     "aisle": "Dairy"
    }
   ],
   "steps": [
    {
     "text": "Mix the flour, yeast, sugar, salt, warm water and oil and knead for 10 minutes until smooth.",
     "min": 12
    },
    {
     "text": "Cover and leave to rise for an hour until doubled.",
     "min": 60
    },
    {
     "text": "Heat the oven to 220C. Divide into 8, roll each into two thin ropes, twist them together and join the ends into a ring.",
     "min": 20
    },
    {
     "text": "Dip each ring in the molasses mixed with the water, then press into the sesame seeds on both sides.",
     "min": 8
    },
    {
     "text": "Rest on lined trays for 15 minutes.",
     "min": 15
    },
    {
     "text": "Bake for 15 minutes until deep golden.",
     "min": 15
    },
    {
     "text": "Cool slightly and serve with the feta.",
     "min": 5
    }
   ],
   "veg": true,
   "af": true
  },
