  {
   "n": "Hush puppies",
   "course": "s",
   "prep_min": 15,
   "cook_min": 15,
   "make_ahead": "",
   "ingredients": [
    {
     "q": 150,
     "u": "g",
     "item": "cornmeal",
     "aisle": "Pantry"
    },
    {
     "q": 75,
     "u": "g",
     "item": "plain flour",
     "aisle": "Pantry"
    },
    {
     "q": 2,
     "u": "tsp",
     "item": "baking powder",
     "aisle": "Pantry"
    },
    {
     "q": 1,
     "u": "tsp",
     "item": "caster sugar",
     "aisle": "Pantry"
    },
    {
     "q": 1,
     "u": "tsp",
     "item": "fine salt",
     "aisle": "Pantry"
    },
    {
     "q": 200,
     "u": "ml",
     "item": "buttermilk",
     "aisle": "Dairy"
    },
    {
     "q": 1,
     "u": "",
     "item": "egg",
     "aisle": "Dairy"
    },
    {
     "q": 3,
     "u": "",
     "item": "spring onions",
     "aisle": "Produce"
    },
    {
     "q": 60,
     "u": "g",
     "item": "butter, softened",
     "aisle": "Dairy"
    },
    {
     "q": 2,
     "u": "tbsp",
     "item": "honey",
     "aisle": "Pantry"
    },
    {
     "q": 1,
     "u": "l",
     "item": "vegetable oil, for frying",
     "aisle": "Pantry"
    }
   ],
   "steps": [
    {
     "text": "Mix the cornmeal, flour, baking powder, sugar and salt in a bowl.",
     "min": 3
    },
    {
     "text": "Stir in the buttermilk, egg and sliced spring onions to a thick batter.",
     "min": 4
    },
    {
     "text": "Beat the softened butter with the honey until smooth.",
     "min": 3
    },
    {
     "text": "Heat the oil to 180C in a deep pan.",
     "min": 5
    },
    {
     "text": "Drop in teaspoons of batter and fry until golden, turning once. Drain on paper and serve hot with the honey butter.",
     "min": 10
    }
   ],
   "veg": true,
   "af": true
  },
  {
   "n": "Tribeca loft crostini",
   "course": "s",
   "prep_min": 15,
   "cook_min": 5,
   "make_ahead": "",
   "ingredients": [
    {
     "q": 16,
     "u": "",
     "item": "baguette slices (about 1 baguette)",
     "aisle": "Bakery"
    },
    {
     "q": 1,
     "u": "",
     "item": "garlic clove",
     "aisle": "Produce"
    },
    {
     "q": 4,
     "u": "",
     "item": "ripe tomatoes",
     "aisle": "Produce"
    },
    {
     "q": 1,
     "u": "",
     "item": "small bunch basil",
     "aisle": "Produce"
    },
    {
     "q": 2,
     "u": "tbsp",
     "item": "extra virgin olive oil",
     "aisle": "Pantry"
    },
    {
     "q": null,
     "u": "",
     "item": "salt, to taste",
     "aisle": "Pantry"
    }
   ],
   "steps": [
    {
     "text": "Grill the baguette slices until charred at the edges.",
     "min": 5
    },
    {
     "text": "Rub each warm toast with the cut garlic clove.",
     "min": 3
    },
    {
     "text": "Dice the tomatoes and dress with torn basil, salt and olive oil.",
     "min": 7
    },
    {
     "text": "Spoon the tomato onto the toasts just before serving so they stay crisp.",
     "min": 0
    }
   ],
