     "item": "firm mozzarella",
     "aisle": "Deli"
    },
    {
     "q": 1,
     "u": "cup",
     "item": "self-raising flour",
     "aisle": "Pantry"
    },
    {
     "q": 250,
     "u": "ml",
     "item": "cold milk",
     "aisle": "Dairy"
