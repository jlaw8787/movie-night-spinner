  {
   "n": "Numidian honey-fried stuffed dates",
   "course": "s",
   "prep_min": 15,
   "cook_min": 8,
   "make_ahead": "",
   "ingredients": [
    {
     "q": 24,
     "u": "",
     "item": "Medjool dates",
     "aisle": "Produce"
    },
    {
     "q": 24,
     "u": "",
     "item": "whole almonds",
     "aisle": "Pantry"
    },
    {
     "q": 30,
     "u": "g",
     "item": "butter",
     "aisle": "Dairy"
    },
    {
     "q": 3,
     "u": "tbsp",
     "item": "honey",
     "aisle": "Pantry"
    },
    {
     "q": null,
     "u": "",
     "item": "sea salt flakes, to taste",
     "aisle": "Pantry"
    }
   ],
   "steps": [
    {
     "text": "Toast the whole almonds in a dry pan for 4 minutes.",
     "min": 6
    },
    {
     "text": "Slit and pit the Medjool dates, push an almond and a grind of black pepper into each and press closed.",
     "min": 3
    },
    {
     "text": "Melt the butter in a frying pan over medium heat and fry the dates 2 minutes, turning, until warm and glossy.",
     "min": 6
    },
    {
     "text": "Add the honey and let it bubble for 1 minute, turning the dates to coat.",
     "min": 5
    },
    {
     "text": "Tip onto a plate and sprinkle with flaky salt.",
     "min": 3
    }
   ]
  },
