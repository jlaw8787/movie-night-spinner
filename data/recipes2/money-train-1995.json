  {
   "n": "Gold token cookies",
   "course": "s",
   "prep_min": 25,
   "cook_min": 45,
   "make_ahead": "Up to 3 days, airtight",
   "ingredients": [
    {
     "q": 200,
     "u": "g",
     "item": "soft butter",
     "aisle": "Dairy"
    },
    {
     "q": 100,
     "u": "g",
     "item": "icing sugar",
     "aisle": "Pantry"
    },
    {
     "q": 300,
     "u": "g",
     "item": "plain flour",
     "aisle": "Pantry"
    },
    {
     "q": 1,
     "u": "",
     "item": "small jar edible gold dust",
     "aisle": "Pantry"
    }
   ],
   "steps": [
    {
     "text": "Beat the butter and icing sugar until pale, then mix in the flour to a soft dough.",
     "min": 10
    },
    {
     "text": "Chill the dough for 15 minutes so it rolls cleanly.",
     "min": 15
    },
    {
     "text": "Roll 5mm thick, cut rounds the size of a subway token and cut a small hole from the middle of each.",
     "min": 15
    },
    {
     "text": "Bake at 160C until just set and pale gold.",
     "min": 15
    },
    {
     "text": "Cool on the tray, then brush with gold dust mixed with a drop of water.",
     "min": 10
    }
   ]
  },
