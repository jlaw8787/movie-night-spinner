  {
   "n": "Token booth honey roasted nuts",
   "course": "s",
   "prep_min": 5,
   "cook_min": 20,
   "make_ahead": "Up to 3 days, airtight",
   "ingredients": [
    {
     "q": 300,
     "u": "g",
     "item": "mixed nuts",
     "aisle": "Pantry"
    },
    {
     "q": 2,
     "u": "tbsp",
     "item": "honey",
     "aisle": "Pantry"
    },
    {
     "q": 1,
     "u": "tbsp",
     "item": "caster sugar",
     "aisle": "Pantry"
    },
    {
     "q": 0.5,
     "u": "tsp",
     "item": "ground cinnamon",
     "aisle": "Spices"
    },
    {
     "q": 1,
     "u": "",
     "item": "pinch of salt",
     "aisle": "Pantry"
    }
   ],
   "steps": [
    {
     "text": "Toss the nuts with the honey, sugar, cinnamon and salt until coated.",
     "min": 5
    },
    {
     "text": "Spread on a lined tray and roast at 170C, stirring halfway.",
     "min": 15
    },
    {
     "text": "Keep stirring as they cool so they do not clump.",
     "min": 5
    }
   ],
   "veg": true,
   "af": true
  },
  {
   "n": "Gold token cookies",
   "course": "s",
   "prep_min": 25,
   "cook_min": 45,
   "make_ahead": "Up to 3 days, airtight",
   "ingredients": [
    {
     "q": 200,
     "u": "g",
     "item": "soft butter",
     "aisle": "Dairy"
    },
    {
     "q": 100,
     "u": "g",
     "item": "icing sugar",
     "aisle": "Pantry"
    },
    {
     "q": 300,
     "u": "g",
     "item": "plain flour",
     "aisle": "Pantry"
    },
    {
     "q": 1,
     "u": "",
     "item": "small jar edible gold dust",
     "aisle": "Pantry"
    }
   ],
   "steps": [
    {
     "text": "Beat the butter and icing sugar until pale, then mix in the flour to a soft dough.",
     "min": 10
    },
    {
     "text": "Chill the dough for 15 minutes so it rolls cleanly.",
     "min": 15
    },
    {
     "text": "Roll 5mm thick, cut rounds the size of a subway token and cut a small hole from the middle of each.",
     "min": 15
    },
    {
     "text": "Bake at 160C until just set and pale gold.",
     "min": 15
    },
    {
     "text": "Cool on the tray, then brush with gold dust mixed with a drop of water.",
     "min": 10
    }
   ],
   "veg": true,
   "af": true
  },
  {
   "n": "Arroz con pollo",
   "course": "m",
   "prep_min": 20,
   "cook_min": 45,
   "make_ahead": "Up to 1 day, reheat with a splash of stock",
   "ingredients": [
    {
     "q": 800,
     "u": "g",
     "item": "chicken thighs",
     "aisle": "Meat"
    },
    {
     "q": 1,
     "u": "",
     "item": "brown onion, diced",
     "aisle": "Produce"
    },
    {
     "q": 1,
     "u": "",
     "item": "capsicum, diced",
     "aisle": "Produce"
