     "q": 2,
     "u": "tbsp",
     "item": "oil for browning",
     "aisle": "Pantry"
    }
   ],
   "steps": [
    {
     "text": "Brown the chicken in the oil in a wide lidded pan until golden, then set aside.",
     "min": 10
    },
    {
     "text": "Fry the onion, capsicum, garlic and coriander in the same pan until soft.",
     "min": 10
    },
    {
     "text": "Stir in the annatto, rice, olives, capers and stock and bring to a simmer.",
     "min": 5
    },
    {
     "text": "Sit the chicken on top, cover and cook on low until the rice is tender.",
     "min": 25
    },
    {
     "text": "Rest, covered, before serving.",
     "min": 5
    }
