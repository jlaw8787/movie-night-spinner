     "u": "g",
     "item": "cooked red beans, tinned and drained",
     "aisle": "Pantry"
    }
   ],
   "steps": [
    {
     "text": "Score the pork skin. Pound the garlic, oregano and salt to a paste with the juice and oil.",
     "min": 15
    },
    {
     "text": "Rub the paste deep into the pork and marinate in the fridge overnight, or at least 4 hours.",
     "min": 5
