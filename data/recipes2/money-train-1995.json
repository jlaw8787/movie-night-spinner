  {
   "n": "Guava pastelitos",
   "course": "w",
   "prep_min": 20,
   "cook_min": 25,
   "make_ahead": "Up to 1 day, crisp in the oven before serving",
   "ingredients": [
    {
     "q": 2,
     "u": "",
     "item": "sheets puff pastry",
     "aisle": "Frozen"
    },
    {
     "q": 250,
     "u": "g",
     "item": "guava paste",
     "aisle": "Pantry"
    },
    {
     "q": 150,
     "u": "g",
     "item": "cream cheese",
     "aisle": "Dairy"
    },
    {
     "q": 3,
     "u": "tbsp",
     "item": "caster sugar",
     "aisle": "Pantry"
    },
    {
     "q": 3,
     "u": "tbsp",
     "item": "water",
     "aisle": "Pantry"
    }
   ],
   "steps": [
    {
     "text": "Thaw the pastry, then cut each sheet into 8 squares.",
     "min": 8
    },
    {
     "text": "Put a slice of guava paste and a little cream cheese on half the squares, cover with the rest and seal the edges with a fork.",
     "min": 12
    },
    {
     "text": "Bake at 200C until puffed and golden.",
     "min": 20
    },
    {
     "text": "Simmer the sugar with the water for a few minutes to make a syrup, then brush it over the warm pastries.",
     "min": 5
    }
   ],
