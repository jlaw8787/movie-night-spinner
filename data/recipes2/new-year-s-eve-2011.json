  {
   "n": "Laura's prawn and avocado tostada bites",
   "course": "s",
   "prep_min": 31,
   "cook_min": 18,
   "make_ahead": "Crisps and onion up to 1 day ahead, assemble just before serving",
   "ingredients": [
    {
     "q": 4,
     "u": "",
     "item": "corn tortillas",
     "aisle": "Bakery"
    },
    {
     "q": 1,
     "u": "tbsp",
     "item": "vegetable oil",
     "aisle": "Pantry"
    },
    {
     "q": 16,
     "u": "",
     "item": "cooked king prawns",
     "aisle": "Seafood"
    },
    {
     "q": 3,
     "u": "",
     "item": "limes",
     "aisle": "Produce"
    },
    {
     "q": 0.5,
     "u": "tsp",
     "item": "chilli flakes",
     "aisle": "Pantry"
    },
    {
     "q": 2,
     "u": "",
     "item": "avocados",
     "aisle": "Produce"
    },
    {
     "q": 1,
     "u": "",
     "item": "red onion",
     "aisle": "Produce"
    },
    {
     "q": 1,
     "u": "",
     "item": "bunch of coriander",
     "aisle": "Produce"
    }
   ],
   "steps": [
    {
     "text": "Cut small rounds from the tortillas with a 6cm cutter and brush with oil.",
     "min": 10
    },
    {
     "text": "Bake at 200C until crisp, then cool.",
     "min": 8
    },
    {
     "text": "Toss the peeled prawns with lime juice and chilli flakes.",
     "min": 5
    },
    {
     "text": "Mash the avocados with lime juice and salt.",
     "min": 6
    },
    {
     "text": "Thinly slice the red onion.",
     "min": 4
    },
    {
     "text": "Soak the onion in lime juice for 10 minutes.",
     "min": 10
    },
    {
     "text": "Top each crisp with avocado, a prawn, a few onion slivers and a coriander leaf.",
     "min": 6
    }
   ],
