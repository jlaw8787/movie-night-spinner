  {
   "n": "Keith's tea and brown butter shortbread",
   "course": "w",
   "prep_min": 30,
   "cook_min": 75,
   "make_ahead": "Keeps 1 week airtight",
   "ingredients": [
    {
     "q": 200,
     "u": "g",
     "item": "butter",
     "aisle": "Dairy"
    },
    {
     "q": 90,
     "u": "g",
     "item": "caster sugar",
     "aisle": "Pantry"
    },
    {
     "q": 250,
     "u": "g",
     "item": "plain flour",
     "aisle": "Pantry"
    },
    {
     "q": 30,
     "u": "g",
     "item": "cornflour",
     "aisle": "Pantry"
    },
    {
     "q": 1,
     "u": "",
     "item": "pinch salt",
     "aisle": "Spices"
    },
    {
     "q": 1,
     "u": "tbsp",
     "item": "demerara sugar",
     "aisle": "Pantry"
    },
    {
     "q": 1,
     "u": "",
     "item": "pinch flaky sea salt",
     "aisle": "Spices"
    },
    {
     "q": 4,
     "u": "tsp",
     "item": "loose black tea",
     "aisle": "Drinks"
    },
    {
     "q": 300,
     "u": "ml",
     "item": "milk",
     "aisle": "Dairy"
    }
   ],
   "steps": [
    {
     "text": "Melt the butter and cook until nutty and golden brown. Chill until firm but soft.",
     "min": 20
    },
    {
     "text": "Beat with the caster sugar until pale, then mix in the flour, cornflour and salt.",
     "min": 10
    },
    {
     "text": "Press into a lined 20cm square tin, sprinkle with demerara and flaky salt, prick all over.",
     "min": 8
    },
    {
     "text": "Bake at 160C for 35 minutes.",
     "min": 35
    },
    {
     "text": "Cut into fingers while warm.",
     "min": 5
    },
    {
     "text": "Brew a pot of black tea for 4 minutes and serve alongside with milk.",
     "min": 5
    }
   ],
   "veg": true,
   "af": true
  },
