   "n": "Homemade Scooby Snacks",
   "course": "s",
   "prep_min": 20,
   "cook_min": 15,
   "make_ahead": "Bake up to 5 days ahead and keep in an airtight tin",
   "ingredients": [
    {
     "q": 150,
     "u": "g",
     "item": "plain flour",
     "aisle": "Pantry"
    },
    {
     "q": 50,
     "u": "g",
     "item": "rolled oats",
     "aisle": "Pantry"
    },
    {
     "q": 100,
     "u": "g",
     "item": "cold butter, cubed",
     "aisle": "Dairy"
    },
    {
     "q": 120,
     "u": "g",
     "item": "vintage cheddar, grated",
     "aisle": "Dairy"
    },
    {
     "q": 1,
     "u": "",
     "item": "egg yolk",
     "aisle": "Dairy"
    },
    {
     "q": 2,
     "u": "tbsp",
     "item": "cold water",
     "aisle": "Pantry"
    },
    {
     "q": 1,
     "u": "tsp",
     "item": "sweet paprika",
     "aisle": "Spices"
    }
   ],
   "steps": [
    {
     "text": "Pulse the flour, oats, butter, cheese and paprika in a food processor until it looks like breadcrumbs.",
     "min": 3
    },
    {
     "text": "Add the yolk and water and pulse until it comes together, then wrap and chill for 10 minutes.",
     "min": 12
    },
    {
     "text": "Roll out 5mm thick and cut into bone shapes.",
     "min": 5
    },
    {
     "text": "Bake on a lined tray at 180C until golden, then cool on the tray.",
     "min": 15
    }
   ],
   "veg": true,
