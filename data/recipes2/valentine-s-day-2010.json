  {
   "n": "Pistachio chocolate-dipped strawberries",
   "course": "s",
   "prep_min": 25,
   "cook_min": 20,
   "make_ahead": "",
   "ingredients": [
    {
     "q": 500,
     "u": "g",
     "item": "strawberries, stalks on",
     "aisle": "Produce"
    },
    {
     "q": 150,
     "u": "g",
     "item": "dark chocolate",
     "aisle": "Pantry"
    },
    {
     "q": 50,
     "u": "g",
     "item": "pistachios, finely chopped",
     "aisle": "Pantry"
    },
    {
     "q": 50,
     "u": "g",
     "item": "white chocolate",
     "aisle": "Pantry"
    },
    {
     "q": 10,
     "u": "g",
     "item": "freeze-dried raspberries, crushed",
     "aisle": "Pantry"
    }
   ],
   "steps": [
    {
     "text": "Wash the strawberries and dry them completely.",
     "min": 5
    },
    {
     "text": "Melt the dark chocolate in a bowl over simmering water.",
     "min": 5
    },
    {
     "text": "Dip each berry two-thirds of the way in, let the excess drip off and roll the base in pistachios. Lay on baking paper.",
     "min": 12
    },
    {
     "text": "Melt the white chocolate and drizzle over with a fork, then dust with crushed raspberry.",
     "min": 3
    },
    {
     "text": "Chill until set.",
     "min": 20
    }
   ]
  },
