{
 "serves": 4,
 "dishes": [
  {
   "n": "Moscow cabbage pirozhki",
   "course": "s",
   "prep_min": 35,
   "cook_min": 100,
   "make_ahead": "Make the filling up to 2 days ahead; the baked buns keep 1 day airtight and reheat well, or freeze them for a month",
   "ingredients": [
    {
     "q": 500,
     "u": "g",
     "item": "plain flour",
     "aisle": "Pantry"
    },
    {
     "q": 7,
     "u": "g",
     "item": "dried yeast",
     "aisle": "Pantry"
    },
    {
     "q": 1,
     "u": "tbsp",
     "item": "caster sugar",
     "aisle": "Pantry"
    },
    {
     "q": 1.5,
     "u": "tsp",
     "item": "salt",
     "aisle": "Pantry"
    },
    {
     "q": 250,
     "u": "ml",
     "item": "milk, warmed",
     "aisle": "Dairy"
    },
    {
     "q": 60,
     "u": "g",
     "item": "butter, melted, for the dough",
     "aisle": "Dairy"
    },
    {
     "q": 1,
     "u": "",
     "item": "egg, for the dough",
     "aisle": "Dairy"
    },
    {
     "q": 2,
     "u": "",
     "item": "eggs, for the filling",
     "aisle": "Dairy"
    },
    {
     "q": 500,
     "u": "g",
     "item": "white cabbage, finely shredded",
     "aisle": "Produce"
    },
    {
     "q": 1,
     "u": "",
     "item": "onion, diced",
     "aisle": "Produce"
    },
    {
     "q": 40,
     "u": "g",
     "item": "butter, for the filling",
     "aisle": "Dairy"
    },
    {
     "q": 0.5,
     "u": "tsp",
     "item": "black pepper",
     "aisle": "Spices"
    },
    {
     "q": 2,
     "u": "tbsp",
     "item": "dill, chopped",
     "aisle": "Produce"
    },
    {
     "q": 1,
     "u": "",
     "item": "egg, beaten, for brushing",
     "aisle": "Dairy"
    }
   ],
   "steps": [
    {
     "text": "Mix the flour, yeast, sugar and 1 tsp of the salt with the warm milk, melted butter and egg for the dough, and knead until smooth.",
     "min": 12
    },
    {
     "text": "Cover and prove until doubled. Meanwhile boil the eggs for the filling for 9 minutes, and cook the cabbage and onion slowly in the butter until soft and sweet.",
     "min": 60
    },
    {
     "text": "Season the cabbage with the rest of the salt and the pepper, cool a little, then mix in the chopped eggs and dill.",
     "min": 10
    },
    {
     "text": "Divide the dough into 16, flatten each piece, fill, pinch closed and set seam side down on lined trays.",
     "min": 20
    },
    {
     "text": "Rest the buns while the oven heats to 200C.",
     "min": 15
    },
    {
     "text": "Brush with the beaten egg and bake until golden.",
     "min": 18
    }
   ],
   "veg": true,
   "af": true
  },
