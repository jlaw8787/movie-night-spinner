     "q": 1,
     "u": "",
     "item": "egg, beaten, for brushing",
     "aisle": "Dairy"
    }
   ],
   "steps": [
    {
     "text": "Mix the flour, yeast, sugar and 1 tsp of the salt with the warm milk, melted butter and egg for the dough, and knead until smooth.",
     "min": 12
    },
    {
     "text": "Cover and prove until doubled. Meanwhile boil the eggs for the filling for 9 minutes, and cook the cabbage and onion slowly in the butter until soft and sweet.",
     "min": 60
    },
    {
     "text": "Season the cabbage with the rest of the salt and the pepper, cool a little, then mix in the chopped eggs and dill.",
     "min": 10
    },
    {
     "text": "Divide the dough into 16, flatten each piece, fill, pinch closed and set seam side down on lined trays.",
     "min": 20
    },
    {
     "text": "Rest the buns while the oven heats to 200C.",
     "min": 15
    },
    {
     "text": "Brush with the beaten egg and bake until golden.",
     "min": 18
    }
