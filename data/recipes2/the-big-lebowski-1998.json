  {
   "n": "Persian rug flatbread",
   "course": "s",
   "prep_min": 28,
   "cook_min": 15,
   "make_ahead": "Whipped feta up to 2 days ahead, chilled. Cook the flatbreads just before serving",
   "ingredients": [
    {
     "q": 300,
     "u": "g",
     "item": "self-raising flour",
     "aisle": "Pantry"
    },
    {
     "q": 350,
     "u": "g",
     "item": "Greek yoghurt",
     "aisle": "Dairy"
    },
    {
     "q": 1,
     "u": "tsp",
     "item": "salt",
     "aisle": "Pantry"
    },
    {
     "q": 200,
     "u": "g",
     "item": "feta",
     "aisle": "Dairy"
    },
    {
     "q": 1,
     "u": "",
     "item": "lemon",
     "aisle": "Produce"
    },
    {
     "q": 4,
     "u": "tbsp",
     "item": "olive oil",
     "aisle": "Pantry"
    },
    {
     "q": 2,
     "u": "tbsp",
     "item": "za'atar",
     "aisle": "Pantry"
    },
    {
     "q": 2,
     "u": "tsp",
     "item": "sumac",
     "aisle": "Pantry"
    },
    {
     "q": 2,
     "u": "tsp",
     "item": "nigella seeds",
     "aisle": "Pantry"
    },
    {
     "q": 80,
     "u": "g",
     "item": "pomegranate seeds",
     "aisle": "Produce"
    },
    {
     "q": 1,
     "u": "",
     "item": "small bunch mint",
     "aisle": "Produce"
    },
    {
     "q": 1,
     "u": "",
     "item": "small bunch dill",
     "aisle": "Produce"
    }
   ],
   "steps": [
    {
     "text": "Mix the flour, 250g of the yoghurt and the salt into a soft dough, knead for 1 minute, then rest 10 minutes.",
     "min": 15
    },
    {
     "text": "Whip the feta with the remaining 100g yoghurt, the lemon zest and juice and 2 tbsp of the olive oil until smooth.",
     "min": 5
    },
    {
     "text": "Divide the dough into 4 and roll each piece into a thin rectangle about 25cm long.",
     "min": 5
    },
    {
     "text": "Cook each flatbread in a hot dry frying pan for 2 minutes a side, until puffed and charred in spots.",
     "min": 12
    },
    {
     "text": "Brush with the rest of the olive oil and sprinkle the za'atar, sumac and nigella seeds in stripes across each one, like a rug.",
     "min": 3
    },
    {
     "text": "Spread the whipped feta on a platter, lay the flatbreads alongside and scatter with the pomegranate, mint and dill.",
     "min": 3
    }
   ],
   "veg": true,
   "af": true
  },
  {
