   "steps": [
    {
     "text": "Cut the potatoes into chips, rinse and dry thoroughly.",
     "min": 10
    },
    {
     "text": "Blanch in oil at 140C for 5 minutes and drain.",
     "min": 5
    },
    {
     "text": "Cool the chips for 15 minutes (included in cook time).",
     "min": 15
