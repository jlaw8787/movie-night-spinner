    {
     "q": 1,
     "u": "bunch",
     "item": "flat-leaf parsley",
     "aisle": "Produce"
    }
   ],
   "steps": [
    {
     "text": "Heat the oven to 200C. Cut 16 rounds of pastry with a 6cm cutter, then cut a smaller circle half way through each.",
     "min": 8
    },
    {
     "text": "Brush with egg and bake 15 minutes until puffed. Push the centres down while warm.",
     "min": 15
