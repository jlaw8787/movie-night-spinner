  {
   "n": "Stan Mikita's mini jam doughnuts",
   "course": "s",
   "prep_min": 40,
   "cook_min": 110,
   "make_ahead": "Best the same day",
   "ingredients": [
    {
     "q": 350,
     "u": "g",
     "item": "plain flour",
     "aisle": "Pantry"
    },
    {
     "q": 7,
     "u": "g",
     "item": "dried yeast",
     "aisle": "Pantry"
    },
    {
     "q": 180,
     "u": "ml",
     "item": "milk",
     "aisle": "Dairy"
    },
    {
     "q": 30,
     "u": "g",
     "item": "butter",
     "aisle": "Dairy"
    },
    {
     "q": 120,
     "u": "g",
     "item": "caster sugar",
     "aisle": "Pantry"
    },
    {
     "q": 1,
     "u": "",
     "item": "egg",
     "aisle": "Dairy"
    },
    {
     "q": 1,
     "u": "",
     "item": "pinch salt",
     "aisle": "Pantry"
    },
    {
     "q": 150,
     "u": "g",
     "item": "raspberry jam",
     "aisle": "Pantry"
    },
    {
     "q": 2,
     "u": "l",
     "item": "vegetable oil",
     "aisle": "Pantry"
    }
   ],
   "steps": [
    {
     "text": "Warm the milk with the butter and a little of the sugar, then mix with the yeast, egg, flour and salt.",
     "min": 10
    },
    {
     "text": "Knead until smooth and elastic.",
     "min": 5
    },
    {
     "text": "Prove until doubled.",
     "min": 60
    },
    {
     "text": "Roll into 20 balls and prove again.",
     "min": 20
    },
    {
     "text": "Fry at 175C for a couple of minutes, turning, until golden.",
     "min": 10
    },
    {
     "text": "Roll in the remaining sugar while warm, then poke a hole in each and pipe in raspberry jam.",
     "min": 5
    }
   ],
   "veg": true,
   "af": true
  },
