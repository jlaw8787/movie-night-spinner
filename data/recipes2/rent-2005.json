   "n": "Avenue B cart soft pretzels with mustard",
   "course": "s",
   "prep_min": 30,
   "cook_min": 85,
   "make_ahead": "Best baked on the day; shape the pretzels and keep them covered in the fridge up to 4 hours, then boil and bake",
   "ingredients": [
    {
     "q": 500,
     "u": "g",
     "item": "bread flour",
     "aisle": "Pantry"
    },
    {
     "q": 7,
     "u": "g",
     "item": "dried yeast",
     "aisle": "Pantry"
    },
    {
     "q": 1,
     "u": "tbsp",
     "item": "sugar",
     "aisle": "Pantry"
    },
    {
     "q": 2,
     "u": "tsp",
     "item": "salt",
     "aisle": "Pantry"
    },
    {
     "q": 30,
     "u": "g",
     "item": "butter, melted",
     "aisle": "Dairy"
    },
    {
     "q": 325,
     "u": "ml",
     "item": "warm water",
     "aisle": "Pantry"
    },
    {
     "q": 2,
     "u": "l",
     "item": "water, for the bath",
     "aisle": "Pantry"
    },
    {
     "q": 80,
     "u": "g",
     "item": "bicarbonate of soda",
     "aisle": "Pantry"
    },
    {
     "q": 1,
     "u": "",
     "item": "egg, beaten",
     "aisle": "Dairy"
    },
    {
     "q": 1,
     "u": "tbsp",
     "item": "coarse sea salt",
     "aisle": "Pantry"
    },
    {
     "q": 4,
     "u": "tbsp",
     "item": "yellow mustard",
     "aisle": "Pantry"
    },
    {
     "q": 4,
     "u": "tbsp",
     "item": "wholegrain mustard",
     "aisle": "Pantry"
    }
   ],
   "steps": [
    {
     "text": "Mix the flour, yeast, sugar, salt, melted butter and warm water and knead until smooth.",
     "min": 10
    },
    {
     "text": "Cover and leave somewhere warm until doubled.",
     "min": 60
    },
    {
     "text": "Heat the oven to 220C. Cut the dough into 8, roll each into a long rope and twist into a pretzel.",
     "min": 15
    },
    {
     "text": "Boil the water for the bath with the bicarbonate of soda and dip each pretzel for 30 seconds, then lift onto lined trays.",
     "min": 12
    },
    {
     "text": "Brush with the egg, scatter with the coarse salt and bake until deep brown.",
     "min": 14
    },
    {
     "text": "Serve warm with the yellow and wholegrain mustard in bowls.",
     "min": 4
    }
   ],
