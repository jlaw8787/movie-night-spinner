  {
   "n": "Kinako dango with brown sugar syrup",
   "course": "w",
   "prep_min": 20,
   "cook_min": 10,
   "make_ahead": "Make the syrup a week ahead. Cook the dango on the day",
   "ingredients": [
    {
     "q": 100,
     "u": "g",
     "item": "dark brown sugar",
     "aisle": "Pantry"
    },
    {
     "q": 200,
     "u": "g",
     "item": "glutinous rice flour",
     "aisle": "Pantry"
    },
    {
     "q": 40,
     "u": "g",
     "item": "kinako (roasted soybean flour)",
     "aisle": "Pantry"
    },
    {
     "q": 1,
     "u": "tbsp",
     "item": "caster sugar",
     "aisle": "Pantry"
    }
   ],
   "steps": [
    {
     "text": "Simmer the brown sugar with 80ml water until syrupy and cool.",
     "min": 5
    },
    {
     "text": "Mix the rice flour with water to a soft dough and roll into 24 dimpled balls.",
     "min": 10
    },
    {
     "text": "Boil until they float, 1 minute more, then into iced water.",
     "min": 6
    },
    {
     "text": "Roll in kinako and sugar, skewer and pour the syrup over.",
     "min": 4
    }
   ],
   "veg": true,
