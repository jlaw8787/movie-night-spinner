  {
   "n": "Honour guard yaki onigiri",
   "course": "s",
   "prep_min": 25,
   "cook_min": 20,
   "make_ahead": "Shape up to 4 hours ahead, grill before serving",
   "ingredients": [
    {
     "q": 2,
     "u": "cup",
     "item": "short grain rice",
     "aisle": "Pantry"
    },
    {
     "q": 2,
     "u": "tbsp",
     "item": "white miso",
     "aisle": "Pantry"
    },
    {
     "q": 1,
     "u": "tbsp",
     "item": "soy sauce",
     "aisle": "Pantry"
    },
    {
     "q": 1,
     "u": "tsp",
     "item": "caster sugar",
     "aisle": "Pantry"
    },
    {
     "q": 2,
     "u": "",
     "item": "nori sheets",
     "aisle": "Pantry"
    }
   ],
   "steps": [
    {
     "text": "Cook the rice and cool until you can handle it.",
     "min": 25
    },
    {
     "text": "With wet salted hands, press into 8 firm triangles.",
     "min": 8
    },
    {
     "text": "Mix the miso, soy and sugar.",
     "min": 2
    },
    {
     "text": "Grill the onigiri 4 minutes a side until crisp, brushing with the glaze at the end, then wrap the base in nori.",
     "min": 10
    }
   ],
   "veg": true,
   "af": true
