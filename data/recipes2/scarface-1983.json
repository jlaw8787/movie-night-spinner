  {
   "n": "Freedom Town croquetas de jamón",
   "course": "s",
   "prep_min": 30,
   "cook_min": 500,
   "make_ahead": "Chill the bechamel overnight; crumb up to 4 hours ahead and fry to serve",
   "ingredients": [
    {
     "q": 60,
     "u": "g",
     "item": "butter",
     "aisle": "Dairy"
    },
    {
     "q": 70,
     "u": "g",
     "item": "plain flour",
     "aisle": "Pantry"
    },
    {
     "q": 500,
     "u": "ml",
     "item": "warm milk",
     "aisle": "Dairy"
    },
    {
     "q": 100,
     "u": "g",
     "item": "serrano ham, finely chopped",
     "aisle": "Meat"
    },
    {
     "q": 1,
     "u": "",
     "item": "pinch ground nutmeg",
     "aisle": "Spices"
    },
    {
     "q": 2,
     "u": "",
     "item": "eggs, beaten",
     "aisle": "Dairy"
    },
    {
     "q": 100,
     "u": "g",
     "item": "fine breadcrumbs",
     "aisle": "Pantry"
    },
    {
     "q": 500,
     "u": "ml",
     "item": "neutral oil, for frying",
     "aisle": "Pantry"
    },
    {
     "q": 1,
     "u": "",
     "item": "lime, cut in wedges",
     "aisle": "Produce"
    }
   ],
   "steps": [
    {
     "text": "Melt the butter, stir in the flour for 2 minutes, then whisk in the warm milk and cook until very thick.",
     "min": 10
    },
    {
     "text": "Stir in the ham and nutmeg, spread on a tray, cover and chill overnight.",
     "min": 480
    },
    {
     "text": "Roll into 16 logs, dip in egg and then breadcrumbs.",
     "min": 15
    },
    {
     "text": "Fry at 180C in batches until golden and serve with lime.",
     "min": 12
    }
   ],
   "veg": false,
   "af": true
