    "aisle": "Pantry"
   }
  ],
  "steps": [
   {
    "text": "Heat the oil in a large lidded pot over medium-high heat with 3 kernels in. When they pop, add the rest of the popping corn, lid on.",
    "min": 2
   },
   {
    "text": "Shake the pot every 20 seconds until the popping slows to a few seconds apart, then tip into a big bowl.",
    "min": 3
   },
   {
    "text": "Melt the butter, pour it over, toss and season with the salt.",
    "min": 1
   }
  ]
